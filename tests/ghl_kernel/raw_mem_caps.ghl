module "raw_mem_caps";

# Positive companion to raw_mem_forbidden.ghl: the SAME raw store compiles once
# the module declares the `unsafe raw_mem` authority it touches. Pairing the two
# fixtures proves the gate keys off the capability, not the builtin name.
unsafe raw_mem;

global ghl_test_raw_mem_caps;

data scratch: 8 = 0;

fn ghl_test_raw_mem_caps() {
    sq(&scratch, 1);   # raw store -> allowed under unsafe raw_mem
    return lq(&scratch);
}
