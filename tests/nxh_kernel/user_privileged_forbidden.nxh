app "user_privileged_forbidden" { stack = 4096; }

# Negative fixture (nhl-beyond-zero-trust-todo.md "compiler tests proving user
# apps cannot request privileged intrinsics"). A ring-3 app reaches for a
# control-register write. The privileged-intrinsic gate is keyed off the build
# TARGET, not just the unsafe cap, so this MUST fail to compile under --target
# user even though the app declares the matching authority below: a user blob
# can never emit `mov cr0, rax`. Compile error expected: "requires --target
# kernel". See the companion exact_authority_caps.nxh for the kernel side.
unsafe kernel_creg;

fn main() {
    write_cr0(0);   # privileged -> rejected: not --target kernel
    return 0;
}
