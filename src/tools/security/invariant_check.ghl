# THREAT: an authority-graph edit that widens privilege or creates a confused-deputy path past the proven seL4-style invariants.
# GHL-native authority-graph INVARIANT kernel (seL4 validity track).
#
# This module encodes the machine-checkable invariants that bound damage after a
# single-component compromise. It is NOT a claim of formal seL4 equivalence: it
# is the adapted, explicitly-scoped subset of seL4-style properties this project
# chooses to preserve (see docs/track3-sel4-validity-todo.md). Each invariant
# names the compromised component and the authority it must NOT have.
#
# Authority is modeled as a bitmask. A domain "has" an authority iff its bit is
# set. Every predicate fails closed (returns 0 on any violation).
#
# The declarative invariant files in tests/security/invariants/*.invariant
# reference the predicates below by name; the runner asserts each referenced
# predicate exists and that this module compiles --forbid-asm --deny-unsafe.

module "security_invariant_check";

global inv_subset;
global inv_lacks_authority;
global inv_requires_threshold;
global inv_same_domain;
global inv_flag_absent;
global inv_scheduler_no_memory_grant;
global inv_ipc_no_identity_forge;
global inv_driver_no_dma_mint;
global inv_pt_no_persist_without_threshold;
global inv_policy_loader_signed_only;
global inv_hypervisor_no_foreign_measurement;
global inv_release_no_observation;
global inv_recovery_no_measure_bypass;
global inv_ipc_no_deputy_laundering;
global inv_app_mem_isolation;
global inv_compartment_one_authority;
global inv_compartment_no_cross_map;
global inv_compartment_no_auth_launder;
global inv_context_bound;
global inv_ephemeral_no_replay;
global inv_per_slot_key_confined;
global inv_syscall_perm_per_launch;
global inv_planted_cap_hmac_rejected;
global inv_no_rollback;
global inv_floor_ratchet_monotonic;
global inv_cfi_forward_target_in_set;
global inv_cfi_no_offset_entry;
global inv_safestack_return_unwritable;

# Authority bits. One bit per mintable authority in the model.
const AUTH_MEMORY_GRANT = 1;       # map/grant memory to another domain
const AUTH_MINT_IDENTITY = 2;      # assert/forge a component identity
const AUTH_DMA_MAP = 4;            # create a DMA window
const AUTH_PERSIST = 8;            # authorize persistent on-disk state
const AUTH_SIGN_MEASUREMENT = 16;  # sign a trusted measurement
const AUTH_INSTALL_POLICY = 32;    # install capability policy
const AUTH_GLOBAL = 64;            # global / root authority (never single-domain)

# --- Primitive invariants ---------------------------------------------------

# Capability derivation never increases authority: a derived (child) capability's
# authority must be a subset of its parent's. seL4's core "no authority
# amplification" property, adapted.
fn inv_subset(child_auth, parent_auth) {
    if (child_auth & parent_auth) == child_auth {
        return 1;
    }
    return 0;
}

# A domain must NOT hold a forbidden authority bit.
fn inv_lacks_authority(domain_auth, forbidden_bit) {
    if (domain_auth & forbidden_bit) != 0 {
        return 0;
    }
    return 1;
}

# A sensitive authority may be exercised only when threshold approval is present.
fn inv_requires_threshold(domain_auth, sensitive_bit, threshold_met) {
    if (domain_auth & sensitive_bit) != 0 {
        if threshold_met == 0 {
            return 0;
        }
    }
    return 1;
}

# A signature/measurement binds to exactly one domain; cross-domain signing is
# forbidden (no domain may sign for another).
fn inv_same_domain(signer_domain, target_domain) {
    if signer_domain == target_domain {
        return 1;
    }
    return 0;
}

# A flag (e.g. release telemetry) must be absent.
fn inv_flag_absent(flag) {
    if flag == 0 {
        return 1;
    }
    return 0;
}

# --- Named single-compromise containment invariants -------------------------

# A compromised scheduler cannot grant memory access.
fn inv_scheduler_no_memory_grant(scheduler_auth) {
    return inv_lacks_authority(scheduler_auth, AUTH_MEMORY_GRANT);
}

# A compromised IPC router cannot forge component identity.
fn inv_ipc_no_identity_forge(ipc_auth) {
    return inv_lacks_authority(ipc_auth, AUTH_MINT_IDENTITY);
}

# A compromised device driver cannot mint DMA access on its own.
fn inv_driver_no_dma_mint(driver_auth, dma_grant_present) {
    if (driver_auth & AUTH_DMA_MAP) != 0 {
        if dma_grant_present == 0 {
            return 0;
        }
    }
    return 1;
}

# A compromised page-table manager cannot authorize persistence without
# threshold policy approval.
fn inv_pt_no_persist_without_threshold(pt_auth, threshold_met) {
    return inv_requires_threshold(pt_auth, AUTH_PERSIST, threshold_met);
}

# A compromised policy loader cannot install unsigned policy.
fn inv_policy_loader_signed_only(policy_signed) {
    if policy_signed == 0 {
        return 0;
    }
    return 1;
}

# A compromised hypervisor module cannot sign a trusted measurement for an
# unrelated module: it may only measure its own domain.
fn inv_hypervisor_no_foreign_measurement(signer_domain, measured_domain, signs_measurement) {
    if signs_measurement == 0 {
        return 1;
    }
    return inv_same_domain(signer_domain, measured_domain);
}

# Release builds must not observe the user: no telemetry/logging/identifier flag.
fn inv_release_no_observation(telemetry_present) {
    return inv_flag_absent(telemetry_present);
}

# Recovery cannot be used to skip measurement: execution proceeds only when the
# measured hash matches the expected hash, and `recovery_mode` is quantified
# over both values to prove it grants NO exemption (the non-bypass claim is
# that the predicate is constant in recovery_mode).
fn inv_recovery_no_measure_bypass(recovery_mode, measured_hash, expected_hash, proceeds) {
    if proceeds == 0 {
        return 1;
    }
    if measured_hash == expected_hash {
        return 1;
    }
    return 0;
}

# No confused deputy: when a deputy (proxy) performs an operation on behalf of
# a requester, the exercised authority must be a subset of BOTH the requester's
# and the deputy's own authority â€" a peer cannot launder authority the
# requester never had, and a requester cannot push the deputy past its own.
fn inv_ipc_no_deputy_laundering(requester_auth, deputy_auth, op_auth) {
    if inv_subset(op_auth, requester_auth) == 0 {
        return 0;
    }
    return inv_subset(op_auth, deputy_auth);
}

# Memory isolation between apps: a read across namespaces is permitted only
# through an explicitly shared handle. Same-namespace access and non-granted
# access are always fine; cross-namespace granted access without a shared
# handle is the violation.
fn inv_app_mem_isolation(reader_ns, owner_ns, shared_handle, access_granted) {
    if access_granted == 0 {
        return 1;
    }
    if reader_ns == owner_ns {
        return 1;
    }
    if shared_handle != 0 {
        return 1;
    }
    return 0;
}

# --- Track 6 (compartmentalized "-1" monitor) containment invariants --------
#
# The monitor is decomposed into single-authority compartments (PT/KEY/HASH/
# CAP/DMA/LOAD-MON). These three predicates make the C1 isolation claim
# machine-checkable (Track 6 Phase C3): one authority each, no cross-region
# map, and no authority laundering across the trampoline.

# COMPARTMENT-ONE-AUTHORITY: a compartment's authority bitmask is a singleton â€"
# it owns exactly one mintable authority. Zero authority (a powerless
# compartment is still a violation of the "owns exactly one" model) and any
# bitmask with two or more bits set both fail closed. Singleton iff the mask is
# a non-zero power of two: `auth != 0 && (auth & (auth - 1)) == 0`.
fn inv_compartment_one_authority(comp_auth) {
    if comp_auth == 0 {
        return 0;
    }
    if (comp_auth & (comp_auth - 1)) == 0 {
        return 1;
    }
    return 0;
}

# COMPARTMENT-NO-CROSS-MAP: no compartment holds page-map authority over
# another compartment's region. Map authority may be exercised only over the
# holder's own region; a present map authority targeting a foreign region is
# the violation. When no map authority is asserted, nothing is mapped and the
# state is vacuously safe.
fn inv_compartment_no_cross_map(comp_region, target_region, map_present) {
    if map_present == 0 {
        return 1;
    }
    if comp_region == target_region {
        return 1;
    }
    return 0;
}

# COMPARTMENT-NO-AUTH-LAUNDER: the cross-compartment trampoline transfers NO
# caller authority. After a trampoline cross, the callee runs with exactly its
# own authority regardless of who called it. The theorem is that this predicate
# is CONSTANT in caller_auth (the runner quantifies over all caller values):
# the effective authority must equal the callee's own authority, so a caller
# can neither widen nor narrow what the callee may do.
fn inv_compartment_no_auth_launder(caller_auth, callee_auth, effective_auth) {
    if effective_auth == callee_auth {
        return 1;
    }
    return 0;
}

# --- Track 4 (leak != elevation) replay-binding invariants -------------------
#
# These encode, as machine-checked theorems, the load-bearing Track-4 Part D
# claim that a secret recovered from a RAM dump of boot/slot/launch A does NOT
# authorize on a fresh boot/slot/launch B. Each authenticator is bound to a
# per-context nonce (per-boot epoch, per-slot id, per-launch syscall
# permutation); presenting it in a different context must fail closed. The
# primitive states the binding once; the three named invariants bind it to the
# three real diversification axes audited in
# docs/track4-data-egress-elevation-matrix.md (barriers 1, 2/4, 3).

# A context-bound authenticator validates only when the presented context
# matches the live context. When it does not authenticate at all, the state is
# vacuously safe (nothing was accepted).
fn inv_context_bound(secret_ctx, live_ctx, authenticates) {
    if authenticates == 0 {
        return 1;
    }
    if secret_ctx == live_ctx {
        return 1;
    }
    return 0;
}

# Barrier (1): per-boot ephemeral secrets. A canary/nonce/mem-key drawn in
# boot A (epoch_a) is statistically unrelated to boot B (epoch_b); a dumped one
# authenticates only against its own boot epoch.
fn inv_ephemeral_no_replay(secret_epoch, live_epoch, authenticates) {
    return inv_context_bound(secret_epoch, live_epoch, authenticates);
}

# Barriers (2)+(4): per-slot key + per-slot ASLR slide. A key/slide minted for
# slot i never authenticates for slot j; a leaked one is confined to its slot.
fn inv_per_slot_key_confined(key_slot, live_slot, authenticates) {
    return inv_context_bound(key_slot, live_slot, authenticates);
}

# Barrier (3): heterogeneous per-launch syscall numbering. A static exploit
# blob built against launch A's permutation dispatches to its intended
# privileged handler only under that same permutation; under launch B's
# permutation it lands elsewhere (out-of-range -> .sc_invalid). "dispatches"
# means "reaches the intended handler"; the theorem is it cannot under a
# foreign permutation.
fn inv_syscall_perm_per_launch(blob_perm_id, live_perm_id, dispatches) {
    return inv_context_bound(blob_perm_id, live_perm_id, dispatches);
}

# --- Planted-leak NEGATIVE test: dumped cap-mask + MAC rejected on fresh boot ---
#
# The empirical "plant the dumped secret and prove elevation fails" half of Track
# 4 Part D, over the REAL 128-bit cap-mask MAC arithmetic (not an abstract
# label). The dispatcher trusts slot_cap_mask[] only if BOTH 64-bit lanes in
# slot_cap_hmac[slot] re-derive under the LIVE per-boot canary. This mirrors
# cap_mask_store/cap_mask_verify in syscall_secure.ghl exactly: a keyed base over
# (canary, slot, full 16-bit mask, domain), followed by the same 64-bit finalizer
# with an independent gamma for each lane.
#
# A one-shot dump of boot A yields a (mask, MAC) tuple (mask WIDENED, MAC valid
# under boot A's canary). Planted on a fresh boot B, acceptance is sound ONLY when
# both lanes recomputed under the live canary equal the planted pair - which for
# a foreign-canary MAC happens only on a 128-bit collision. A fresh boot draws a
# new canary, so the planted MAC fails closed -> CANARY panic, never a silent
# widen.
const KDOM_CAP_MASK = 0x5C;
const CAPMAC_U64    = 0xFFFFFFFFFFFFFFFF;
const CAPMAC_SLOT_MASK = 0xFF;
const CAPMAC_MASK_MASK = 0xFFFF;
const CAPMAC_SM_A   = 0x9E3779B97F4A7C15;
const CAPMAC_SM_B   = 0xC2B2AE3D27D4EB4F;
const CAPMAC_C1     = 0xBF58476D1CE4E5B9;
const CAPMAC_C2     = 0x94D049BB133111EB;
const CAPMAC_G0     = 0xD1B54A32D192ED03;
const CAPMAC_G1     = 0xA0761D6478BD642F;

# Explicit CAPMAC_U64 masks make the production machine-word wrapping visible
# to the pure host evaluator as well as to compiled GHL.
fn cap_mask_mac_lane(canary, slot, mask, gamma) {
    let slot_term = ((slot & CAPMAC_SLOT_MASK) * CAPMAC_SM_A) & CAPMAC_U64;
    let mask_term = ((mask & CAPMAC_MASK_MASK) * CAPMAC_SM_B) & CAPMAC_U64;
    let base = (canary ^ slot_term ^ mask_term ^ KDOM_CAP_MASK) & CAPMAC_U64;
    let x = (base ^ gamma) & CAPMAC_U64;
    x = ((x ^ (x >> 30)) * CAPMAC_C1) & CAPMAC_U64;
    x = ((x ^ (x >> 27)) * CAPMAC_C2) & CAPMAC_U64;
    return (x ^ (x >> 31)) & CAPMAC_U64;
}

fn inv_planted_cap_hmac_rejected(dump_canary, live_canary, slot, mask, planted_lane0, planted_lane1, accepted) {
    let live_lane0 = cap_mask_mac_lane(live_canary, slot, mask, CAPMAC_G0);
    let live_lane1 = cap_mask_mac_lane(live_canary, slot, mask, CAPMAC_G1);
    if accepted == 0 {
        return 1;
    }
    if planted_lane0 == live_lane0 {
        if planted_lane1 == live_lane1 {
            return 1;
        }
    }
    return 0;
}

# --- Track 2 (signed everything) anti-rollback invariants -------------------
#
# The persistent floor store (floor_store.ghl) and the RTC forward-ratchet keep
# a monotonic per-class minimum (version/counter/epoch + clock high-water) in a
# checksummed data.img sector, loaded before any admission and ratcheted by
# every accepted envelope. These two theorems state the anti-rollback property
# the QEMU phase-8 power-cycle test exercises empirically.

# NO-ROLLBACK: a signed artifact is admitted only when its version is at least
# the persisted floor. A validly-signed but superseded artifact (version below
# the floor a later build already ratcheted past) is inadmissible. When nothing
# is admitted the state is vacuously safe.
fn inv_no_rollback(artifact_version, floor_version, admitted) {
    if admitted == 0 {
        return 1;
    }
    if artifact_version >= floor_version {
        return 1;
    }
    return 0;
}

# FLOOR-RATCHET-MONOTONIC: the persisted floor only ever moves forward. A
# ratchet that would lower the stored minimum (a rollback of the floor itself)
# is rejected; equal or higher is accepted. This is the forward-ratchet that
# makes NO-ROLLBACK durable across a power cycle.
fn inv_floor_ratchet_monotonic(old_floor, new_floor) {
    if new_floor >= old_floor {
        return 1;
    }
    return 0;
}

# --- Track 11 (structural CFI + memory-safety-by-construction) invariants -----
#
# The L4 "CFI-as-a-checked-theorem" modeling layer (see
# docs/track11-structural-cfi-memsafety-todo.md). These make the structural
# forward-edge, mid-function, and backward-edge (SafeStack) claims
# machine-checkable on the SAME vehicle as the Track-3/6 invariants, BEFORE the
# L1/L2 codegen exists: they bound what a *sound* emitter is allowed to admit, so
# a later call-graph/table edit that would admit an off-set indirect transfer or
# a foreign write to a return slot is caught by the exhaustive proof. This is the
# model, not the runtime enforcement (L1 tables / L2 SafeStack emission remain
# not-started) - exactly as Track 6 C3 landed `proven` while C0/C1 stayed design.

# Bounded modeling spaces (NOT AUTH_* bits, so they do not widen the authority
# enumeration used by the Track-3/6 proofs). Small, high-signal ranges that still
# cover every equal/unequal and member/non-member combination.
const CFI_TYPEID_COUNT = 8;    # distinct call-site/target type signatures modeled
const CFI_OFFSET_SPAN  = 64;   # byte offsets into a function (0 = the entry)
const CFI_WRITER_COUNT = 8;    # distinct write-path identities modeled

# CFI-FORWARD-TARGET-IN-SET (L1): an indirect forward transfer is admitted only
# when the resolved target's type signature equals the call site's signature AND
# the target is a member of that type's call table (`target in table[typeid]`).
# A forged target with a foreign typeid, OR a same-typeid target that is not in
# the table, is rejected. This is the fine-grained forward edge that beats PAC
# (no "any pointer signed with this modifier") and CET-IBT (no "any ENDBR"):
# BOTH the type match and table membership are required.
fn inv_cfi_forward_target_in_set(site_typeid, target_typeid, target_in_table) {
    if site_typeid == target_typeid {
        if target_in_table != 0 {
            return 1;
        }
    }
    return 0;
}

# CFI-NO-MIDFUNCTION-ENTRY (L1): a forward target must be a function ENTRY
# (offset 0), never a mid-function offset. Landing mid-function is the JOP/ROP
# gadget-entry primitive coarse IBT permits; a sound emitter admits only offset
# 0. The runner quantifies over the whole offset span to prove every non-zero
# offset is rejected.
fn inv_cfi_no_offset_entry(target_offset) {
    if target_offset == 0 {
        return 1;
    }
    return 0;
}

# SAFESTACK-RETURN-NO-FOREIGN-WRITE (L2): a write that targets a protected-stack
# return slot is admitted ONLY from the canonical push/ret write path. Any other
# writer identity (an unsafe-stack overflow, an attacker-controlled store) is
# rejected - SafeStack removes the return-address overwrite PRIMITIVE rather than
# detecting a corrupted return after the fact. Writes that do not target a return
# slot are outside this theorem's scope and vacuously admitted. The runner
# quantifies over every writer identity to prove only the canonical one is
# admitted for a return slot.
fn inv_safestack_return_unwritable(writer_id, canonical_writer_id, targets_return_slot) {
    if targets_return_slot == 0 {
        return 1;
    }
    if writer_id == canonical_writer_id {
        return 1;
    }
    return 0;
}
