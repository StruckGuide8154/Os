# Fixed allocation: schema v1 permits at most 64 tokens. The compiler/loader
# zeroes this per-app state. There is no allocation and no untrusted index can
# escape the table because theme_col/theme_override validate against TC_COUNT.
const PALETTE_SLOTS = 64
const PALETTE_BYTES = 512
state {
    theme_palette: 512;
    theme_state: 8;
}

# theme_state byte 0 = active theme id, byte 1 = initialized.
fn theme_active() { return lb(&theme_state); }
fn theme_inited() { return lb(&theme_state + 1); }

fn theme_set_state(id, inited) {
    if id < 0 { id = THEME_ACTIVE_ID; }
    if id > 255 { id = THEME_ACTIVE_ID; }
    sb(&theme_state, id);
    sb(&theme_state + 1, inited);
}

fn theme_slot_addr(idx) { return &theme_palette + idx * 8; }

fn theme_sync() {
    if theme_inited() != 0 { return; }
    theme_seed_active();
    theme_set_state(THEME_ACTIVE_ID, 1);
}

# Theme selection is deliberately build-wide. Allowing one process to switch
# would split it from kernel-owned taskbar/window chrome. This compatibility
# helper accepts the active id only; changing `active` in the canonical spec
# and regenerating changes the whole OS atomically.
fn theme_set(id) {
    if id != THEME_ACTIVE_ID { return; }
    theme_seed_active();
    theme_set_state(THEME_ACTIVE_ID, 1);
}

fn theme_init() { theme_sync(); }

fn theme_col(idx) {
    if idx < 0 { return 0; }
    if idx >= TC_COUNT { return 0; }
    if theme_inited() == 0 { theme_init(); }
    return lq(theme_slot_addr(idx));
}

# Intentional app-local accenting. Raw application content (paint colors,
# media, SVG) should stay literal and must not be routed through this API.
fn theme_override(idx, value) {
    if idx < 0 { return; }
    if idx >= TC_COUNT { return; }
    if theme_inited() == 0 { theme_init(); }
    sq(theme_slot_addr(idx), value & 0x00FFFFFF);
}
