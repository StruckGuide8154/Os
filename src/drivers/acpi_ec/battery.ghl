# ============================================================================
# battery.ghl - ACPI EC Battery driver, Track-8 ring-3 driver-host process.
# Compile: --target driver  (forces --forbid-asm + --deny-unsafe; the module
# declares NO unsafe cap and uses NO privileged intrinsic - it reaches the EC
# ONLY through the in-kernel driver_host broker; see
# docs/architecture-userspace-drivers.md guarantees G1-G4 and the Track 8
# ladder in docs/track8-userspace-drivers-todo.md).
#
# EXECUTION MODEL (mirrors virtio_net.ghl, Stage-4b tick-callback):
#   * main()         - the ONE-SHOT probe entry. The device manager
#                      (driver_loader.ghl) has already installed this blob into
#                      its own headless slot, registered the driver with the
#                      broker, and granted the EC port pair 0x62/0x66 BEFORE
#                      this runs (Fork-B ordering). main() probes the EC
#                      register layout, publishes the first reading, sets
#                      `ready`, and RETURNS - it never loops.
#   * battery_tick() - the bounded periodic entry. The kernel main loop's
#                      battery service invokes it (via the broker tick guard)
#                      about once a second; each call performs at most one EC
#                      register sweep and returns. No-freeze by construction.
#
# WHY ONE DRIVER IS ENOUGH
#   The ACPI Embedded Controller interface (EC port I/O: 0x62 data, 0x66
#   command/status) is a fixed ACPI standard. Every laptop-class EC exposes
#   this port pair. The register MAP inside the EC is vendor-specific; we probe
#   layouts D/A/B/C as in the retired battery.asm (Acer Nitro / ITE8xxx
#   families). Unlisted machines (and QEMU, which has no EC) fall back to
#   "AC/100%" rather than crashing; an absent EC is detected fast (status
#   0xFF = open bus, the same all-ones a denied broker access returns).
#
# THREAT MODEL (what code-exec in THIS driver buys an attacker): nothing toward
# the kernel. The driver holds only the PIO capability class with a grant over
# ports {0x62..0x66}. A compromised battery driver can read/write those EC
# ports and scribble its own ring-3 slot - it cannot reach kernel memory,
# MMIO, DMA, IRQs, or any port outside the grant.
# ============================================================================

app "battery" { stack = 4096; }

# ---------------------------------------------------------------------------
# driver_host broker syscall ABI (SC_DRVHOST_* family; identity numbering in a
# driver slot). Caller identity is the slot derived by syscall entry - the
# broker NEVER accepts a driver_id from ring 3.
# ---------------------------------------------------------------------------
const SC_DRVHOST_PIO_READ8  = 244   # (port) -> byte (0xFF on deny/absent)
const SC_DRVHOST_PIO_WRITE8 = 245   # (port, val) -> rc

const DRV_OK = 0

# ---------------------------------------------------------------------------
# EC hardware constants (mirrors the retired battery.asm).
# ---------------------------------------------------------------------------
const EC_DATA     = 0x62     # EC data register port
const EC_CMD      = 0x66     # EC command/status port
const EC_IBF      = 2        # bit 1: input buffer full  (busy, can't write)
const EC_OBF      = 1        # bit 0: output buffer full (data ready to read)
const EC_READ_CMD = 0x80     # "read register" command byte

# EC register layouts: A, B, C, D (Acer Nitro / ITE8xxx variants).
const EC_REG_A_BAT_CAP   = 0xA2
const EC_REG_A_BAT_FLAGS = 0xA3
const EC_REG_A_AC_STATUS = 0xA4

const EC_REG_B_BAT_FLAGS = 0x40
const EC_REG_B_AC_STATUS = 0x41
const EC_REG_B_BAT_CAP   = 0x42

const EC_REG_C_REM_LO    = 0xB2
const EC_REG_C_REM_HI    = 0xB3
const EC_REG_C_DES_LO    = 0xB4
const EC_REG_C_DES_HI    = 0xB5
const EC_REG_C_STATUS    = 0xA0
const EC_REG_C_AC        = 0xA1

# Layout D: Acer Strix Point - identified by two EC signature bytes.
const EC_REG_D_AC        = 0x00
const EC_REG_D_SIG1      = 0x07
const EC_REG_D_SIG1_VAL  = 0x41
const EC_REG_D_SIG2      = 0x04
const EC_REG_D_SIG2_VAL  = 0x06

# battery_state values (published to the kernel-side status cells).
const BAT_STATE_UNKNOWN   = 0
const BAT_STATE_AC        = 1
const BAT_STATE_DISCHARGE = 2
const BAT_STATE_CHARGING  = 3

# Layout codes.
const EC_LAYOUT_NONE = 0
const EC_LAYOUT_A    = 1
const EC_LAYOUT_B    = 2
const EC_LAYOUT_C    = 3
const EC_LAYOUT_D    = 4

# EC wait spin limit. Each spin is one broker syscall, so this is deliberately
# far below the retired .asm's inline 500000: a real EC clears IBF in
# microseconds, and an ABSENT EC is detected before ever spinning (status 0xFF
# fast-fail below), so this bound is only reached on a wedged-but-present EC.
const EC_SPIN_MAX = 20000

# ---------------------------------------------------------------------------
# Driver-private state (ring-3 local; MMU-confined). The device manager reads
# ready/ec_ok/bat_state/bat_pct back through the slot handoff after each call.
# ---------------------------------------------------------------------------
state {
    ready:        4;   # 1 once the one-shot probe finished (loader binds on it)
    ec_ok:        4;   # 1 = EC responded during probe (tick does work)
    bat_state:    4;   # BAT_STATE_*
    bat_pct:      4;   # 0-100
    bat_layout:   4;   # EC_LAYOUT_*
    bat_design:   4;   # layout C: design capacity (mWh/10, 16-bit range)
}

# ---------------------------------------------------------------------------
# Brokered EC port access - the ONLY way we touch hardware. Identity is derived
# by the kernel from our slot; a denied port returns 0xFF like an open bus.
# ---------------------------------------------------------------------------
fn ec_read_port(port) {
    return syscall(SC_DRVHOST_PIO_READ8, port);
}

fn ec_write_port(port, val) {
    return syscall(SC_DRVHOST_PIO_WRITE8, port, val);
}

# ---------------------------------------------------------------------------
# wait_ibf - wait until EC input buffer is NOT full (we can send).
# Returns 1 = ready, 0 = timed out / absent.
# ---------------------------------------------------------------------------
fn wait_ibf() {
    let spins = 0;
    while spins < EC_SPIN_MAX {
        let s = ec_read_port(EC_CMD);
        if s == 0xFF { return 0; }           # open bus / denied -> absent
        if (s & EC_IBF) == 0 { return 1; }
        spins = spins + 1;
    }
    return 0;
}

# wait_obf - wait until EC output buffer IS full (data ready).
# Returns 1 = data ready, 0 = timed out / absent.
fn wait_obf() {
    let spins = 0;
    while spins < EC_SPIN_MAX {
        let s = ec_read_port(EC_CMD);
        if s == 0xFF { return 0; }           # open bus / denied -> absent
        if (s & EC_OBF) != 0 { return 1; }
        spins = spins + 1;
    }
    return 0;
}

# ---------------------------------------------------------------------------
# ec_read_reg - EC "read register" protocol:
#   1. wait IBF=0   2. write EC_READ_CMD to cmd port   3. wait IBF=0
#   4. write register address to data port             5. wait OBF=1
#   6. read data from data port
# Returns byte value on success, 0x1FF (> 0xFF) on timeout/absent.
# ---------------------------------------------------------------------------
fn ec_read_reg(reg) {
    if wait_ibf() == 0 { return 0x1FF; }
    ec_write_port(EC_CMD, EC_READ_CMD);
    if wait_ibf() == 0 { return 0x1FF; }
    ec_write_port(EC_DATA, reg);
    if wait_obf() == 0 { return 0x1FF; }
    return ec_read_port(EC_DATA);
}

# ---------------------------------------------------------------------------
# probe_layout - try layouts D, A, B, C in order; set bat_layout, return it.
# Layout D is first because it has a real board signature, avoiding false
# positives from the "value in 0-100?" checks the other layouts rely on.
# ---------------------------------------------------------------------------
fn probe_layout() {
    # --- EC presence fast-check: an absent EC (QEMU, desktop boards) reads
    # 0xFF on the status port; bail before any protocol spin. ---
    if ec_read_port(EC_CMD) == 0xFF {
        sw(&bat_layout, EC_LAYOUT_NONE);
        return EC_LAYOUT_NONE;
    }

    # --- Layout D: two signature bytes must match exactly ---
    let v = ec_read_reg(EC_REG_D_SIG1);
    if v != 0x1FF {
        if v == EC_REG_D_SIG1_VAL {
            let v2 = ec_read_reg(EC_REG_D_SIG2);
            if v2 != 0x1FF {
                if v2 == EC_REG_D_SIG2_VAL {
                    let ac = ec_read_reg(EC_REG_D_AC);
                    if ac != 0x1FF {
                        if ac <= 1 {
                            sw(&bat_layout, EC_LAYOUT_D);
                            return EC_LAYOUT_D;
                        }
                    }
                }
            }
        }
    }

    # --- Layout A: reg 0xA2 must be 0-100 ---
    let cap_a = ec_read_reg(EC_REG_A_BAT_CAP);
    if cap_a != 0x1FF {
        if cap_a <= 100 {
            sw(&bat_layout, EC_LAYOUT_A);
            return EC_LAYOUT_A;
        }
    }

    # --- Layout B: reg 0x42 must be 0-100 ---
    let cap_b = ec_read_reg(EC_REG_B_BAT_CAP);
    if cap_b != 0x1FF {
        if cap_b <= 100 {
            sw(&bat_layout, EC_LAYOUT_B);
            return EC_LAYOUT_B;
        }
    }

    # --- Layout C: design capacity must be 10-64999 (non-zero, plausible mWh) ---
    let des_lo = ec_read_reg(EC_REG_C_DES_LO);
    if des_lo != 0x1FF {
        let des_hi = ec_read_reg(EC_REG_C_DES_HI);
        if des_hi != 0x1FF {
            let des = (des_hi & 255) * 256 + (des_lo & 255);
            if des >= 10 {
                if des <= 64999 {
                    sw(&bat_design, des);
                    sw(&bat_layout, EC_LAYOUT_C);
                    return EC_LAYOUT_C;
                }
            }
        }
    }

    sw(&bat_layout, EC_LAYOUT_NONE);
    return EC_LAYOUT_NONE;
}

# ---------------------------------------------------------------------------
# determine_state(ac_byte, flags_byte) -> BAT_STATE_*
# ac_byte bit0=1 means AC present; flags_byte bit1=1 means charging.
# ---------------------------------------------------------------------------
fn determine_state(ac_byte, flags_byte) {
    if (ac_byte & 1) == 0 { return BAT_STATE_DISCHARGE; }
    if (flags_byte & 2) != 0 { return BAT_STATE_CHARGING; }
    return BAT_STATE_AC;
}

# ---------------------------------------------------------------------------
# do_read - one bounded EC register sweep; update bat_state / bat_pct.
# ---------------------------------------------------------------------------
fn do_read() {
    let layout = lw(&bat_layout);

    if layout == EC_LAYOUT_D {
        let ac = ec_read_reg(EC_REG_D_AC);
        if ac == 0x1FF { return 0; }
        sw(&bat_pct, 100);
        if (ac & 1) != 0 { sw(&bat_state, BAT_STATE_AC); }
        if (ac & 1) == 0 { sw(&bat_state, BAT_STATE_DISCHARGE); }
        return 0;
    }

    if layout == EC_LAYOUT_A {
        let ac = ec_read_reg(EC_REG_A_AC_STATUS);
        if ac == 0x1FF { return 0; }
        let cap = ec_read_reg(EC_REG_A_BAT_CAP);
        if cap == 0x1FF { return 0; }
        if cap > 100 { cap = 100; }
        sw(&bat_pct, cap);
        let flags = ec_read_reg(EC_REG_A_BAT_FLAGS);
        if flags == 0x1FF { return 0; }
        sw(&bat_state, determine_state(ac, flags));
        return 0;
    }

    if layout == EC_LAYOUT_B {
        let ac = ec_read_reg(EC_REG_B_AC_STATUS);
        if ac == 0x1FF { return 0; }
        let cap = ec_read_reg(EC_REG_B_BAT_CAP);
        if cap == 0x1FF { return 0; }
        if cap > 100 { cap = 100; }
        sw(&bat_pct, cap);
        let flags = ec_read_reg(EC_REG_B_BAT_FLAGS);
        if flags == 0x1FF { return 0; }
        sw(&bat_state, determine_state(ac, flags));
        return 0;
    }

    if layout == EC_LAYOUT_C {
        let ac = ec_read_reg(EC_REG_C_AC);
        if ac == 0x1FF { return 0; }
        let rem_lo = ec_read_reg(EC_REG_C_REM_LO);
        if rem_lo == 0x1FF { return 0; }
        let rem_hi = ec_read_reg(EC_REG_C_REM_HI);
        if rem_hi == 0x1FF { return 0; }
        let rem = (rem_hi & 255) * 256 + (rem_lo & 255);
        let des = lw(&bat_design);
        let pct = 0;
        if des > 0 {
            pct = rem * 100 / des;
            if pct > 100 { pct = 100; }
        }
        sw(&bat_pct, pct);
        let flags = ec_read_reg(EC_REG_C_STATUS);
        if flags == 0x1FF { return 0; }
        sw(&bat_state, determine_state(ac, flags));
        return 0;
    }

    # EC_LAYOUT_NONE: nothing to do.
    return 0;
}

# ---------------------------------------------------------------------------
# battery_tick - the bounded periodic entry the kernel battery service invokes
# (~1 Hz through the broker tick guard). One EC sweep, then return.
# ---------------------------------------------------------------------------
fn battery_tick() {
    if lw(&ec_ok) == 0 { return 0; }
    do_read();
    return 0;
}

# ---------------------------------------------------------------------------
# main - the ONE-SHOT probe entry (Fork-B ordering: registration + the PIO
# grant already happened in the device manager before this runs). Probes the
# EC, publishes the first reading, sets `ready`, returns. Never loops.
# ---------------------------------------------------------------------------
fn main() {
    sw(&bat_state,  BAT_STATE_UNKNOWN);
    sw(&bat_pct,    0);
    sw(&bat_layout, EC_LAYOUT_NONE);
    sw(&bat_design, 0);
    sw(&ec_ok,      0);

    let layout = probe_layout();
    if layout == EC_LAYOUT_NONE {
        # EC absent / unlisted map: publish the safe desktop default.
        sw(&bat_state, BAT_STATE_AC);
        sw(&bat_pct,   100);
        sw(&ready, 1);
        return 0;
    }

    sw(&ec_ok, 1);
    do_read();
    sw(&ready, 1);
    return 0;
}
