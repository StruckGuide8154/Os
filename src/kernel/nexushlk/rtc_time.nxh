# ============================================================================
# rtc_time.nxh - CMOS RTC wallclock -> unix seconds (Track 2 RTC/now binding).
#
# rtc_now_unix() reads the battery-backed CMOS real-time clock (ports
# 0x70/0x71) and converts the calendar date to unix seconds (UTC). It is the
# kernel's only wallclock source; envelope_gate.nxh binds it into the signed-
# envelope verifier context (validity windows) via gate_time_set at kmain K5.
#
# Hardening / failure model:
#   - the update-in-progress flag (status A bit 7) is waited out with a
#     bounded spin, and the full register set is read twice until two
#     consecutive snapshots agree (an update between reads yields torn time);
#   - BCD (status B bit 2 clear) and 12-hour (bit 1 clear, bit 7 = PM)
#     encodings are both handled; the century register (0x32) is used when
#     plausible, else years are assumed 20xx;
#   - any implausible field (month 0, hour 25, year outside [2000,2200], ...)
#     or persistent read instability returns 0 — the CALLER decides the
#     fail-safe (gate_time_set clamps 0 / too-old values to the build-time
#     floor, so a dead CMOS battery can never move the verifier clock into
#     the past).
#
# Calendar -> days conversion is the days-from-civil algorithm (Howard
# Hinnant); every intermediate stays positive for year >= 2000, so the
# compiler's signed div/mod are exact.
# ============================================================================

module "rtc_time";

unsafe kernel_io;        # inb/outb to the CMOS index/data ports

global rtc_now_unix;

const CMOS_ADDR = 0x70;
const CMOS_DATA = 0x71;

# CMOS register numbers.
const RTC_REG_SEC     = 0;
const RTC_REG_MIN     = 2;
const RTC_REG_HOUR    = 4;
const RTC_REG_DAY     = 7;
const RTC_REG_MONTH   = 8;
const RTC_REG_YEAR    = 9;
const RTC_REG_STATUS_A = 10;
const RTC_REG_STATUS_B = 11;
const RTC_REG_CENTURY = 50;          # 0x32 (ACPI FADT default; 0 if absent)

const RTC_UIP_SPIN_MAX = 200000;     # bounded wait for update-in-progress
const RTC_STABLE_TRIES = 8;          # double-read agreement attempts

fn rtc_cmos_read(reg) {
    # Bit 7 of the index port is the NMI-disable latch; keep it clear (NMI
    # enabled) — these are point reads, not a critical section.
    outb(CMOS_ADDR, reg & 127);
    return inb(CMOS_DATA);
}

# Wait (bounded) until the RTC is not mid-update. 1 = settled, 0 = timeout.
fn rtc_wait_settled() {
    let spins = 0;
    while spins < RTC_UIP_SPIN_MAX {
        if (rtc_cmos_read(RTC_REG_STATUS_A) & 128) == 0 { return 1; }
        spins = spins + 1;
    }
    return 0;
}

fn rtc_decode_field(v, binary_mode) {
    if binary_mode != 0 { return v; }
    return ((v >> 4) & 15) * 10 + (v & 15);   # BCD
}

# One full snapshot -> unix seconds, or 0 if unreadable/implausible.
fn rtc_read_unix_once() {
    if rtc_wait_settled() == 0 { return 0; }
    let sec     = rtc_cmos_read(RTC_REG_SEC);
    let minute  = rtc_cmos_read(RTC_REG_MIN);
    let hour    = rtc_cmos_read(RTC_REG_HOUR);
    let day     = rtc_cmos_read(RTC_REG_DAY);
    let month   = rtc_cmos_read(RTC_REG_MONTH);
    let year    = rtc_cmos_read(RTC_REG_YEAR);
    let century = rtc_cmos_read(RTC_REG_CENTURY);
    let regb    = rtc_cmos_read(RTC_REG_STATUS_B);

    let binary_mode = regb & 4;
    let pm = hour & 128;             # 12-hour mode PM flag (before decode)
    hour = hour & 127;

    sec     = rtc_decode_field(sec, binary_mode);
    minute  = rtc_decode_field(minute, binary_mode);
    hour    = rtc_decode_field(hour, binary_mode);
    day     = rtc_decode_field(day, binary_mode);
    month   = rtc_decode_field(month, binary_mode);
    year    = rtc_decode_field(year, binary_mode);
    century = rtc_decode_field(century, binary_mode);

    if (regb & 2) == 0 {             # 12-hour mode: 12am=0, 12pm=12
        hour = hour % 12;
        if pm != 0 { hour = hour + 12; }
    }

    if century >= 19 {
        if century <= 22 { year = century * 100 + year; }
    }
    if year < 100 { year = 2000 + year; }   # century reg absent/garbage

    # Plausibility gate — any failure means torn/dead CMOS, not a clock.
    if month < 1 { return 0; }
    if month > 12 { return 0; }
    if day < 1 { return 0; }
    if day > 31 { return 0; }
    if hour > 23 { return 0; }
    if minute > 59 { return 0; }
    if sec > 59 { return 0; }
    if year < 2000 { return 0; }
    if year > 2200 { return 0; }

    # days_from_civil(year, month, day) - 719468 = days since 1970-01-01.
    let y = year;
    if month <= 2 { y = y - 1; }
    let era = y / 400;
    let yoe = y - era * 400;
    let mp = month + 9;              # Mar=0 ... Feb=11 month index
    if month > 2 { mp = month - 3; }
    let doy = (153 * mp + 2) / 5 + day - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    let days = era * 146097 + doe - 719468;
    return ((days * 24 + hour) * 60 + minute) * 60 + sec;
}

# Public entry: unix seconds (UTC), or 0 if the RTC is unreadable. Two
# consecutive snapshots must agree (torn mid-update reads never escape).
fn rtc_now_unix() {
    let tries = 0;
    let a = 0;
    let b = 0;
    while tries < RTC_STABLE_TRIES {
        a = rtc_read_unix_once();
        b = rtc_read_unix_once();
        if a != 0 {
            if a == b { return a; }
        }
        tries = tries + 1;
    }
    return 0;
}
