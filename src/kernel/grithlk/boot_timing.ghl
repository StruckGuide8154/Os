# ============================================================================
# Boot timing instrumentation.  ZERO-ASM GritHLK.
#
# A lightweight, always-on per-stage boot profiler. Each call to boot_mark(c1,c2)
#   * timestamps the current TSC into a fixed table, and
#   * emits the live "[c1c2]" progress marker over COM1 immediately,
# so we keep human-visible boot progress AND retain the cycle counts needed to
# produce a timing report. boot_timing_report() is called once at the end of
# kmain bring-up; it walks the table and prints, per stage, the elapsed time in
# microseconds (TSC delta converted via the calibrated cpu_tsc_per_tick), plus a
# cumulative wall-clock and a grand total. Output is framed [BOOTTIME] .. [/BOOTTIME]
# so scripts/test/boot_markers.ps1 (and a future timing harness) can scrape it.
#
# Conversion: 1 PIT tick = 10 ms = 10000 us, and cpu_tsc_per_tick is the TSC
# cycles calibrated per PIT tick, so:  us = tsc_delta * 10000 / cpu_tsc_per_tick.
# If calibration has not run yet (cpu_tsc_per_tick == 0) we print the raw TSC
# delta instead, tagged with 't'.
# ============================================================================

module "boot_timing";

unsafe raw_mem;       # lq/sq/lw/sw against the mark table
unsafe kernel_priv;   # rdtsc() is a privileged CPU intrinsic

global boot_mark;
global boot_timing_report;

extern cpu_tsc_per_tick;   # qword: calibrated TSC cycles per PIT tick (10 ms)

const MAX_MARKS   = 128;   # table capacity; excess marks are dropped (no overrun)
const US_PER_TICK = 10000; # 1 PIT tick = 10 ms = 10000 us

# --- Boot-progress visual block tracer (GRIT_BOOT_TRACE, debug-only) ---------
# Paints a marching grid of colored squares straight to the GOP framebuffer, one
# per boot stage, so a pre-GUI freeze on real hardware is *visible*: the last
# (rightmost/lowest) block painted is the last stage that COMPLETED. Geometry is
# read from the loader handoff block (VBE_INFO_ADDR), so this works from the very
# first kmain stage - before display_init - and needs no driver state. The kernel
# paints the lower band (y >= BT_KERN_BASE_Y); the UEFI loader paints its own row
# in the top band (y=4). See docs/boot-progress-blocks.md.
const VBE_INFO_ADDR  = 0x9000;  # src/include/boot_memory.inc
const VBE_FB_OFF     = 0x00;    # qword: framebuffer base
const VBE_W_OFF      = 0x08;    # dword: width (px)
const VBE_PITCH_OFF  = 0x10;    # dword: pitch (bytes/row)
const BT_BLK_SIZE    = 18;      # filled square edge (px)
const BT_BLK_STRIDE  = 22;      # block-to-block pitch (px) -> 4px gap
const BT_KERN_BASE_Y = 30;      # kernel band top (loader owns the y=4 row)

# ASCII glyphs used in the report framing.
const CH_LBRACK = 91;   # '['
const CH_RBRACK = 93;   # ']'
const CH_SLASH  = 47;   # '/'
const CH_SPACE  = 32;   # ' '
const CH_CR     = 13;
const CH_LF     = 10;
const CH_COLON  = 58;   # ':'
const CH_t      = 116;  # 't' (raw-TSC fallback flag)
const CH_u      = 117;  # 'u'
const CH_s      = 115;  # 's'
const CH_B      = 66;
const CH_O      = 79;
const CH_T      = 84;
const CH_I      = 73;
const CH_M      = 77;
const CH_E      = 69;

# Parallel table: mark_tsc[i] = TSC snapshot, mark_tag[i] = (c1 | c2<<8).
data mark_tsc:   128 x 8 = 0;
data mark_tag:   128 x 4 = 0;
data mark_count: 1 x 4  = 0;

# Per-call kernel block counter (independent of the timing-table cap, so blocks
# keep marching even past MAX_MARKS).
data blk_idx: 1 x 4 = 0;

# Distinct, ordered color for block i. Cycles every 8, so hue + grid position
# together let you count which stage you reached. 0x00RRGGBB.
fn blk_color(i) {
    let c = i & 7;
    if c == 0 { return 0xFF3030; }   # red
    if c == 1 { return 0xFF9020; }   # orange
    if c == 2 { return 0xF0F000; }   # yellow
    if c == 3 { return 0x30D030; }   # green
    if c == 4 { return 0x30D0D0; }   # cyan
    if c == 5 { return 0x4080FF; }   # blue
    if c == 6 { return 0xE040E0; }   # magenta
    return 0xFFFFFF;                 # white
}

# Paint progress block #idx into the band starting at base_y. No-op without a GOP
# framebuffer or sane geometry. Marches left->right, wrapping to the next row.
fn boot_blk_draw(idx, base_y) {
    let fb = lq(VBE_INFO_ADDR + VBE_FB_OFF);
    if fb == 0 { return; }
    let w = lw(VBE_INFO_ADDR + VBE_W_OFF);
    if w == 0 { return; }
    let pitch = lw(VBE_INFO_ADDR + VBE_PITCH_OFF);
    let per_row = w / BT_BLK_STRIDE;
    if per_row == 0 { return; }
    let row = idx / per_row;
    let col = idx - row * per_row;
    let bx = col * BT_BLK_STRIDE + 2;
    let by = base_y + row * BT_BLK_STRIDE;
    let color = blk_color(idx);
    let dy = 0;
    while dy < BT_BLK_SIZE {
        let p = fb + (by + dy) * pitch + bx * 4;
        let dx = 0;
        while dx < BT_BLK_SIZE {
            sw(p + dx * 4, color);
            dx = dx + 1;
        }
        dy = dy + 1;
    }
}

# Advance + paint the next kernel boot-progress block. Compiles to nothing unless
# GRIT_BOOT_TRACE is defined (debug-only flag), so default builds are unchanged.
# Called from boot_mark, so every instrumented boot stage lights up a block.
fn boot_block_next() {
    cfg "GRIT_BOOT_TRACE" {
        let i = lw(&blk_idx);
        boot_blk_draw(i, BT_KERN_BASE_Y);
        sw(&blk_idx, i + 1);
    }
}

# Record a boot stage. c1/c2 are the two tag chars (e.g. 'K','0'). Emits the
# live "[c1c2]\r\n" marker, then stores TSC + tag if there is table room.
fn boot_mark(c1, c2) {
    # Visual boot-progress block (debug-only; no-op without GRIT_BOOT_TRACE).
    # Painted first + unconditionally so it lights up even past the table cap.
    boot_block_next();

    # Live progress marker (always on).
    call svg_dump_putc(al: CH_LBRACK);
    call svg_dump_putc(al: c1);
    call svg_dump_putc(al: c2);
    call svg_dump_putc(al: CH_RBRACK);
    call svg_dump_putc(al: CH_CR);
    call svg_dump_putc(al: CH_LF);

    let n = lw(&mark_count);
    if n >= MAX_MARKS { return; }
    sq(&mark_tsc + n * 8, rdtsc());
    sw(&mark_tag + n * 4, c1 | (c2 << 8));
    sw(&mark_count, n + 1);
}

# Emit "us\r\n" after a decimal number (report helper).
fn report_us_suffix() {
    call svg_dump_putc(al: CH_SPACE);
    call svg_dump_putc(al: CH_u);
    call svg_dump_putc(al: CH_s);
    call svg_dump_putc(al: CH_CR);
    call svg_dump_putc(al: CH_LF);
}

# Convert a TSC delta to microseconds and print it. Falls back to the raw TSC
# delta (prefixed 't') when calibration is unavailable.
fn report_delta(delta) {
    let tpt = lq(&cpu_tsc_per_tick);
    if tpt == 0 {
        call svg_dump_putc(al: CH_t);
        call svg_dump_dec(eax: delta);
        call svg_dump_putc(al: CH_CR);
        call svg_dump_putc(al: CH_LF);
        return;
    }
    let us = (delta * US_PER_TICK) / tpt;
    call svg_dump_dec(eax: us);
    report_us_suffix();
}

# Walk the table and print a per-stage + cumulative timing report.
fn boot_timing_report() {
    # Header: "[BOOTTIME]\r\n"
    call svg_dump_putc(al: CH_LBRACK);
    call svg_dump_putc(al: CH_B); call svg_dump_putc(al: CH_O); call svg_dump_putc(al: CH_O);
    call svg_dump_putc(al: CH_T); call svg_dump_putc(al: CH_T); call svg_dump_putc(al: CH_I);
    call svg_dump_putc(al: CH_M); call svg_dump_putc(al: CH_E);
    call svg_dump_putc(al: CH_RBRACK);
    call svg_dump_putc(al: CH_CR); call svg_dump_putc(al: CH_LF);

    let n = lw(&mark_count);
    if n < 2 {
        # Footer even when empty so scrapers always see the close tag.
        call svg_dump_putc(al: CH_LBRACK); call svg_dump_putc(al: CH_SLASH);
        call svg_dump_putc(al: CH_B); call svg_dump_putc(al: CH_O); call svg_dump_putc(al: CH_O);
        call svg_dump_putc(al: CH_T); call svg_dump_putc(al: CH_T); call svg_dump_putc(al: CH_I);
        call svg_dump_putc(al: CH_M); call svg_dump_putc(al: CH_E);
        call svg_dump_putc(al: CH_RBRACK);
        call svg_dump_putc(al: CH_CR); call svg_dump_putc(al: CH_LF);
        return;
    }

    let base = lq(&mark_tsc);
    let i = 1;
    while i < n {
        let prev = lq(&mark_tsc + (i - 1) * 8);
        let cur  = lq(&mark_tsc + i * 8);
        let tag  = lw(&mark_tag + i * 4);

        # "<tag>: <stage_us> us"  (delta from previous mark)
        call svg_dump_putc(al: tag & 0xFF);
        call svg_dump_putc(al: (tag >> 8) & 0xFF);
        call svg_dump_putc(al: CH_COLON);
        call svg_dump_putc(al: CH_SPACE);
        report_delta(cur - prev);
        i = i + 1;
    }

    # Grand total from first to last mark.
    let total = lq(&mark_tsc + (n - 1) * 8) - base;
    call svg_dump_putc(al: CH_T); call svg_dump_putc(al: CH_O);
    call svg_dump_putc(al: CH_T); call svg_dump_putc(al: CH_COLON);
    call svg_dump_putc(al: CH_SPACE);
    report_delta(total);

    # Footer: "[/BOOTTIME]\r\n"
    call svg_dump_putc(al: CH_LBRACK); call svg_dump_putc(al: CH_SLASH);
    call svg_dump_putc(al: CH_B); call svg_dump_putc(al: CH_O); call svg_dump_putc(al: CH_O);
    call svg_dump_putc(al: CH_T); call svg_dump_putc(al: CH_T); call svg_dump_putc(al: CH_I);
    call svg_dump_putc(al: CH_M); call svg_dump_putc(al: CH_E);
    call svg_dump_putc(al: CH_RBRACK);
    call svg_dump_putc(al: CH_CR); call svg_dump_putc(al: CH_LF);
}
