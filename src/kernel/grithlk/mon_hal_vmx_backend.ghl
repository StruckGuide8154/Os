# THREAT: a compromised ring-0 that clears CR0.WP / rewrites CR3 / sets CR4 bits
# to disarm the below-ring-0 floor. DEFENSE: run the live kernel as a VT-x GUEST
# under a root-mode monitor, with a VMCS configured so those control-register
# writes VM-EXIT into the monitor instead of taking effect. This is the REAL
# Intel VT-x back-end for Track 5 G1 (items 2-4): it executes the actual
# privileged instructions (VMXON / VMCLEAR / VMPTRLD / VMWRITE / VMLAUNCH /
# VMRESUME) via the gritc `kernel_vmx` intrinsics - no model, no asm{} escape.
#
# MATURITY: `tested-accel`-PENDING. Every code path below emits real VMX
# instructions and compiles + assembles, but VMX instructions #UD on QEMU-TCG
# (which implements no root mode), so this is NOT exercised on the normal CI
# boot. It is armed ONLY when mon_hal_detect reports VMX usable, and verified on
# an accel host (`-enable-kvm -cpu host,+vmx` with nested VMX, or real Intel
# silicon) via scripts/test/run_vmx_accel.md. Until that run lands the Track 5
# doc keeps the honest tag. The vendor-neutral ENFORCEMENT DECISIONS (which
# accesses are floor-disable attempts) are the `modeled`/`tested-tcg` math in
# src/tools/security/mon_hal_vmx_vmcs.ghl + mon_hal.ghl; this module is the
# silicon that makes them bite.
#
# Capture split: the GHL-expressible privileged state (CR0/CR3/CR4, GDTR/IDTR
# pseudo-descriptors, TR selector) is read here with the read_crN / sgdt / sidt /
# str_sel intrinsics. The handful of values with no GHL intrinsic (segment
# selectors CS/SS/DS/ES/FS/GS, FS/GS/TR bases) are filled by a tiny boot asm
# trampoline into the CAPTURE BLOCK whose layout is fixed below, and read back
# with lq/lw. Everything else - the whole VMCS program - is here.

module "kernel_mon_hal_vmx_backend";

unsafe kernel_priv;        # subsumes kernel_vmx / kernel_creg / kernel_dtable /
                           # kernel_idtable (VMX insns, CRn, sgdt/sidt/str)
unsafe raw_mem;            # region revision words + capture-block reads
unsafe implicit_extern;    # &vmx_exit_trampoline (host RIP) resolves same-unit

global vmx_backend_arm;
global vmx_backend_status;
global vmx_exit_trampoline;
global vmx_handle_exit;

# ---- MSRs ------------------------------------------------------------------
const IA32_FEATURE_CONTROL = 0x3A;
const IA32_VMX_BASIC = 0x480;
const IA32_VMX_PINBASED_CTLS = 0x481;
const IA32_VMX_PROCBASED_CTLS = 0x482;
const IA32_VMX_EXIT_CTLS = 0x483;
const IA32_VMX_ENTRY_CTLS = 0x484;
const IA32_VMX_PROCBASED_CTLS2 = 0x48B;
const IA32_VMX_CR0_FIXED0 = 0x486;
const IA32_VMX_CR0_FIXED1 = 0x487;
const IA32_VMX_CR4_FIXED0 = 0x488;
const IA32_VMX_CR4_FIXED1 = 0x489;
const IA32_EFER = 0xC0000080;
const IA32_FS_BASE = 0xC0000100;
const IA32_GS_BASE = 0xC0000101;

const FEATCTL_LOCK = 0x1;
const FEATCTL_VMXON_OUTSIDE_SMX = 0x4;
const CR4_VMXE = 0x2000;                       # CR4 bit 13
const VMX_BASIC_REV_MASK = 0x7FFFFFFF;
const ALL_ONES = 0xFFFFFFFFFFFFFFFF;

# ---- VMCS field encodings (Intel SDM Vol.3 appendix) -----------------------
# Control.
const VMCS_PINBASED_CTLS = 0x4000;
const VMCS_PROCBASED_CTLS = 0x4002;
const VMCS_EXCEPTION_BITMAP = 0x4004;
const VMCS_PROCBASED_CTLS2 = 0x401E;
const VMCS_EXIT_CTLS = 0x400C;
const VMCS_ENTRY_CTLS = 0x4012;
const VMCS_MSR_BITMAP = 0x2004;
const VMCS_EPT_POINTER = 0x201A;
const VMCS_LINK_POINTER = 0x2800;
const VMCS_CR0_GUEST_HOST_MASK = 0x6000;
const VMCS_CR4_GUEST_HOST_MASK = 0x6002;
const VMCS_CR0_READ_SHADOW = 0x6004;
const VMCS_CR4_READ_SHADOW = 0x6006;
# Host state.
const VMCS_HOST_CR0 = 0x6C00;
const VMCS_HOST_CR3 = 0x6C02;
const VMCS_HOST_CR4 = 0x6C04;
const VMCS_HOST_FS_BASE = 0x6C06;
const VMCS_HOST_GS_BASE = 0x6C08;
const VMCS_HOST_TR_BASE = 0x6C0A;
const VMCS_HOST_GDTR_BASE = 0x6C0C;
const VMCS_HOST_IDTR_BASE = 0x6C0E;
const VMCS_HOST_RSP = 0x6C14;
const VMCS_HOST_RIP = 0x6C16;
const VMCS_HOST_ES_SEL = 0x0C00;
const VMCS_HOST_CS_SEL = 0x0C02;
const VMCS_HOST_SS_SEL = 0x0C04;
const VMCS_HOST_DS_SEL = 0x0C06;
const VMCS_HOST_FS_SEL = 0x0C08;
const VMCS_HOST_GS_SEL = 0x0C0A;
const VMCS_HOST_TR_SEL = 0x0C0C;
const VMCS_HOST_EFER = 0x2C02;
# Guest state.
const VMCS_GUEST_CR0 = 0x6800;
const VMCS_GUEST_CR3 = 0x6802;
const VMCS_GUEST_CR4 = 0x6804;
const VMCS_GUEST_DR7 = 0x681A;
const VMCS_GUEST_RSP = 0x681C;
const VMCS_GUEST_RIP = 0x681E;
const VMCS_GUEST_RFLAGS = 0x6820;
const VMCS_GUEST_GDTR_BASE = 0x6816;
const VMCS_GUEST_GDTR_LIMIT = 0x4810;
const VMCS_GUEST_IDTR_BASE = 0x6818;
const VMCS_GUEST_IDTR_LIMIT = 0x4812;
const VMCS_GUEST_EFER = 0x2806;
const VMCS_GUEST_LINK_PTR = 0x2800;
const VMCS_GUEST_ACTIVITY = 0x4826;
const VMCS_GUEST_INTERRUPTIBILITY = 0x4824;
# Per-segment guest fields are laid out as 6 regs (ES,CS,SS,DS,FS,GS) then
# LDTR,TR; selector/limit/access/base each stride by 2 between regs.
const VMCS_GUEST_ES_SEL = 0x0800;
const VMCS_GUEST_ES_LIMIT = 0x4800;
const VMCS_GUEST_ES_ACCESS = 0x4814;
const VMCS_GUEST_ES_BASE = 0x6808;
const VMCS_GUEST_TR_SEL = 0x080E;
const VMCS_GUEST_TR_LIMIT = 0x480E;
const VMCS_GUEST_TR_ACCESS = 0x4822;
const VMCS_GUEST_TR_BASE = 0x6814;
const VMCS_GUEST_LDTR_ACCESS = 0x4820;

# Read-only exit-information fields.
const VMCS_EXIT_REASON = 0x4402;
const VMCS_EXIT_QUALIFICATION = 0x6400;
const VMCS_EXIT_INSTR_LEN = 0x440C;

# ---- control-bit requirements ----------------------------------------------
# Proc-based primary: activate secondary controls (bit 31) + CR3-load/store
# exiting are folded via the secondary EPT path; we trap MOV-to-CR via the CR0/4
# guest-host masks (below) rather than unconditional CR3 exiting.
const PROCBASED_ACTIVATE_SECONDARY = 0x80000000;   # bit 31
const PROCBASED2_ENABLE_EPT = 0x2;                  # bit 1
const PROCBASED2_UNRESTRICTED = 0x80;               # bit 7
const EXIT_CTL_HOST_ADDR_SPACE_64 = 0x200;          # bit 9  (host is 64-bit)
const EXIT_CTL_LOAD_EFER = 0x200000;                # bit 21
const ENTRY_CTL_GUEST_64 = 0x200;                   # bit 9  (guest enters IA-32e)
const ENTRY_CTL_LOAD_EFER = 0x8000;                 # bit 15
# 64-bit flat segment access-rights (P=1,DPL=0): code 0xA09B, data 0xC093,
# TSS-busy 0x8B. LDTR unusable = 0x10000.
const SEG_AR_CODE64 = 0xA09B;
const SEG_AR_DATA = 0xC093;
const SEG_AR_TSS = 0x8B;
const SEG_AR_UNUSABLE = 0x10000;
const SEG_LIMIT_FLAT = 0xFFFFFFFF;
const EFER_LMA_LME = 0x500;                         # LME(8)|LMA(10)

# EPT pointer: page-walk-length 4 (bits 5:3 = 3), memory type WB (bits 2:0 = 6),
# OR'd with the EPT PML4 physical address. Identity EPT is built by the caller
# (or by mon_hal_s2 math) and its root passed in.
const EPTP_WB_4LEVEL = 0x1E;                        # (3<<3)|6

# ---- CAPTURE BLOCK layout (filled by the boot asm trampoline) --------------
# Only the values with no GHL intrinsic live here; offsets in bytes.
const CAP_CS_SEL = 0;
const CAP_SS_SEL = 8;
const CAP_DS_SEL = 16;
const CAP_ES_SEL = 24;
const CAP_FS_SEL = 32;
const CAP_GS_SEL = 40;
const CAP_TR_BASE = 48;
const CAP_GUEST_RSP = 56;     # the RSP the guest resumes on (the arming caller's)
const CAP_GUEST_RIP = 64;     # the RIP the guest resumes at (return address)
const CAP_GUEST_RFLAGS = 72;

# ---- module state ----------------------------------------------------------
# Region revision/descriptor scratch + status. dtr_buf holds a 10-byte sgdt/sidt
# pseudo-descriptor (limit:2 @ +0, base:8 @ +2); we read the base at +2 (8 bytes)
# via an unaligned lq of dtr_buf+2 and the limit via lw of dtr_buf.
data vmx_dtr_buf: 2 x 8 = 0;
data vmx_status: 1 x 8 = 0;          # last bring-up result (0 = launched)

const VMXST_IDLE = 0;
const VMXST_NO_FEATURE_CONTROL = 1;
const VMXST_VMXON_FAIL = 2;
const VMXST_VMCS_LOAD_FAIL = 3;
const VMXST_VMWRITE_FAIL = 4;
const VMXST_LAUNCH_FAIL = 5;
const VMXST_LAUNCHED = 6;

fn vmx_backend_status() {
    return lq(&vmx_status);
}

# ---- control-field allowed-0/allowed-1 adjustment --------------------------
# A control MSR is (allowed1 << 32) | allowed0: a bit may be 0 only if its
# allowed0 (low) bit is 0, and 1 only if its allowed1 (high) bit is 1. The
# canonical legalization sets the must-be-1 bits and clears the must-be-0 bits.
fn vmx_adjust_ctls(desired, cap_msr) {
    let allowed0 = cap_msr & 0xFFFFFFFF;
    let allowed1 = cap_msr >> 32;
    return (desired | allowed0) & allowed1;
}

# ---- one guarded VMWRITE ---------------------------------------------------
# Records the first failure in vmx_status and returns nonzero so the caller
# short-circuits. A VMWRITE can only fail on a bad field or no current VMCS -
# both are bring-up bugs, so failing closed (never launch) is correct.
fn vmx_w(field, value) {
    if vmwrite(field, value) != 0 {
        sq(&vmx_status, VMXST_VMWRITE_FAIL);
        return 1;
    }
    return 0;
}

# ---- enter VMX root mode ---------------------------------------------------
# Configures IA32_FEATURE_CONTROL if firmware left it unlocked, legalizes CR0/CR4
# against the fixed-bit MSRs, sets CR4.VMXE, writes the revision id into the
# VMXON region, and executes the real VMXON. Returns 0 on success.
fn vmx_enter_root(vmxon_pa) {
    let fc = rdmsr(IA32_FEATURE_CONTROL);
    if (fc & FEATCTL_LOCK) == 0 {
        # firmware left it to us: enable VMXON-outside-SMX and lock.
        wrmsr(IA32_FEATURE_CONTROL, fc | FEATCTL_VMXON_OUTSIDE_SMX | FEATCTL_LOCK);
    } else {
        if (fc & FEATCTL_VMXON_OUTSIDE_SMX) == 0 {
            sq(&vmx_status, VMXST_NO_FEATURE_CONTROL);
            return 1;          # firmware fused VMX off - cannot proceed
        }
    }

    # Legalize CR0/CR4 to the VMX fixed-bit requirements before VMXON.
    let cr0 = read_cr0();
    cr0 = (cr0 | rdmsr(IA32_VMX_CR0_FIXED0)) & rdmsr(IA32_VMX_CR0_FIXED1);
    write_cr0(cr0);
    let cr4 = read_cr4() | CR4_VMXE;
    cr4 = (cr4 | rdmsr(IA32_VMX_CR4_FIXED0)) & rdmsr(IA32_VMX_CR4_FIXED1);
    write_cr4(cr4);

    # Revision id (no shadow bit) into the VMXON region, then enter root mode.
    let rev = rdmsr(IA32_VMX_BASIC) & VMX_BASIC_REV_MASK;
    sq(vmxon_pa, rev);
    if vmxon(vmxon_pa) != 0 {
        sq(&vmx_status, VMXST_VMXON_FAIL);
        return 1;
    }
    return 0;
}

# ---- load a fresh VMCS as current ------------------------------------------
fn vmx_load_vmcs(vmcs_pa) {
    let rev = rdmsr(IA32_VMX_BASIC) & VMX_BASIC_REV_MASK;
    sq(vmcs_pa, rev);                 # revision id, shadow bit clear
    if vmclear(vmcs_pa) != 0 {
        sq(&vmx_status, VMXST_VMCS_LOAD_FAIL);
        return 1;
    }
    if vmptrld(vmcs_pa) != 0 {
        sq(&vmx_status, VMXST_VMCS_LOAD_FAIL);
        return 1;
    }
    return 0;
}

# ---- program the VM-execution controls + the CR-trap floor -----------------
# This is where the floor is armed. The CR0/CR4 GUEST/HOST MASK marks which bits
# the guest does NOT own: a guest MOV-to-CRn that changes a masked bit (vs the
# read-shadow) VM-EXITs into the monitor instead of taking effect. We mask:
#   CR0.WP (bit 16) + CR0.PG (31) + CR0.PE (0)  -> can't clear WP to patch .text
#   CR4.VMXE (13) + CR4.SMEP (20) + CR4.SMAP (21) -> can't strip enforcement bits
# The read-shadow returns the kernel's real CRn so innocent reads are transparent.
const CR0_MASK_FLOOR = 0x80010001;     # PG | WP | PE
const CR4_MASK_FLOOR = 0x302000;       # SMAP | SMEP | VMXE
fn vmx_program_controls(eptp_pml4_pa, msr_bitmap_pa, guest_cr0, guest_cr4) {
    let pin = vmx_adjust_ctls(0, rdmsr(IA32_VMX_PINBASED_CTLS));
    if vmx_w(VMCS_PINBASED_CTLS, pin) != 0 { return 1; }

    let proc1 = vmx_adjust_ctls(PROCBASED_ACTIVATE_SECONDARY,
                                rdmsr(IA32_VMX_PROCBASED_CTLS));
    if vmx_w(VMCS_PROCBASED_CTLS, proc1) != 0 { return 1; }

    let proc2 = vmx_adjust_ctls(PROCBASED2_ENABLE_EPT | PROCBASED2_UNRESTRICTED,
                                rdmsr(IA32_VMX_PROCBASED_CTLS2));
    if vmx_w(VMCS_PROCBASED_CTLS2, proc2) != 0 { return 1; }

    let exitc = vmx_adjust_ctls(EXIT_CTL_HOST_ADDR_SPACE_64 | EXIT_CTL_LOAD_EFER,
                                rdmsr(IA32_VMX_EXIT_CTLS));
    if vmx_w(VMCS_EXIT_CTLS, exitc) != 0 { return 1; }

    let entryc = vmx_adjust_ctls(ENTRY_CTL_GUEST_64 | ENTRY_CTL_LOAD_EFER,
                                 rdmsr(IA32_VMX_ENTRY_CTLS));
    if vmx_w(VMCS_ENTRY_CTLS, entryc) != 0 { return 1; }

    if vmx_w(VMCS_EXCEPTION_BITMAP, 0) != 0 { return 1; }
    if vmx_w(VMCS_MSR_BITMAP, msr_bitmap_pa) != 0 { return 1; }
    if vmx_w(VMCS_EPT_POINTER, eptp_pml4_pa | EPTP_WB_4LEVEL) != 0 { return 1; }
    if vmx_w(VMCS_LINK_POINTER, ALL_ONES) != 0 { return 1; }

    # The CR-write trap: masked bits are monitor-owned; read-shadow = real CRn.
    if vmx_w(VMCS_CR0_GUEST_HOST_MASK, CR0_MASK_FLOOR) != 0 { return 1; }
    if vmx_w(VMCS_CR4_GUEST_HOST_MASK, CR4_MASK_FLOOR) != 0 { return 1; }
    if vmx_w(VMCS_CR0_READ_SHADOW, guest_cr0) != 0 { return 1; }
    if vmx_w(VMCS_CR4_READ_SHADOW, guest_cr4) != 0 { return 1; }
    return 0;
}

# ---- program host state (-> the monitor) -----------------------------------
# On VM-exit the CPU loads these. Host RIP = the exit trampoline (in this image),
# host RSP = the caller's stack, host CR3 = the current (monitor) page tables.
# Host segments are the kernel's flat selectors from the capture block.
fn vmx_program_host(cap, host_rsp) {
    if vmx_w(VMCS_HOST_CR0, read_cr0()) != 0 { return 1; }
    if vmx_w(VMCS_HOST_CR3, read_cr3()) != 0 { return 1; }
    if vmx_w(VMCS_HOST_CR4, read_cr4()) != 0 { return 1; }
    if vmx_w(VMCS_HOST_EFER, rdmsr(IA32_EFER)) != 0 { return 1; }

    if vmx_w(VMCS_HOST_CS_SEL, lq(cap + CAP_CS_SEL)) != 0 { return 1; }
    if vmx_w(VMCS_HOST_SS_SEL, lq(cap + CAP_SS_SEL)) != 0 { return 1; }
    if vmx_w(VMCS_HOST_DS_SEL, lq(cap + CAP_DS_SEL)) != 0 { return 1; }
    if vmx_w(VMCS_HOST_ES_SEL, lq(cap + CAP_ES_SEL)) != 0 { return 1; }
    if vmx_w(VMCS_HOST_FS_SEL, lq(cap + CAP_FS_SEL)) != 0 { return 1; }
    if vmx_w(VMCS_HOST_GS_SEL, lq(cap + CAP_GS_SEL)) != 0 { return 1; }
    if vmx_w(VMCS_HOST_TR_SEL, str_sel()) != 0 { return 1; }

    if vmx_w(VMCS_HOST_FS_BASE, rdmsr(IA32_FS_BASE)) != 0 { return 1; }
    if vmx_w(VMCS_HOST_GS_BASE, rdmsr(IA32_GS_BASE)) != 0 { return 1; }
    if vmx_w(VMCS_HOST_TR_BASE, lq(cap + CAP_TR_BASE)) != 0 { return 1; }

    sgdt(&vmx_dtr_buf);
    if vmx_w(VMCS_HOST_GDTR_BASE, lq(&vmx_dtr_buf + 2)) != 0 { return 1; }
    sidt(&vmx_dtr_buf);
    if vmx_w(VMCS_HOST_IDTR_BASE, lq(&vmx_dtr_buf + 2)) != 0 { return 1; }

    if vmx_w(VMCS_HOST_RSP, host_rsp) != 0 { return 1; }
    if vmx_w(VMCS_HOST_RIP, &vmx_exit_trampoline) != 0 { return 1; }
    return 0;
}

# ---- program guest state (mirror of the live kernel = identity) ------------
# The guest resumes exactly where the arming caller was: same CR0/3/4, same flat
# 64-bit segments, same GDTR/IDTR/TR, and the RSP/RIP/RFLAGS captured by the boot
# trampoline. Behavior is unchanged - the kernel does not observe it is a guest.
fn vmx_program_guest_segs(cap) {
    # ES,CS,SS,DS,FS,GS share a 2-byte stride for sel/limit/access/base.
    let i = 0;
    while i < 6 {
        let s = i * 2;
        let sel = lq(cap + CAP_ES_SEL + i * 8);    # caller orders ES,CS,SS,DS,FS,GS
        if vmx_w(VMCS_GUEST_ES_SEL + s, sel) != 0 { return 1; }
        if vmx_w(VMCS_GUEST_ES_LIMIT + s, SEG_LIMIT_FLAT) != 0 { return 1; }
        if vmx_w(VMCS_GUEST_ES_BASE + s, 0) != 0 { return 1; }
        i = i + 1;
    }
    # Access rights: CS is index 1 (code64), the other five are data.
    if vmx_w(VMCS_GUEST_ES_ACCESS + 0, SEG_AR_DATA) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_ES_ACCESS + 2, SEG_AR_CODE64) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_ES_ACCESS + 4, SEG_AR_DATA) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_ES_ACCESS + 6, SEG_AR_DATA) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_ES_ACCESS + 8, SEG_AR_DATA) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_ES_ACCESS + 10, SEG_AR_DATA) != 0 { return 1; }

    # TR (busy TSS) + LDTR (unusable).
    if vmx_w(VMCS_GUEST_TR_SEL, str_sel()) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_TR_BASE, lq(cap + CAP_TR_BASE)) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_TR_LIMIT, 0x67) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_TR_ACCESS, SEG_AR_TSS) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_LDTR_ACCESS, SEG_AR_UNUSABLE) != 0 { return 1; }
    return 0;
}

fn vmx_program_guest(cap, guest_cr0, guest_cr4) {
    if vmx_w(VMCS_GUEST_CR0, guest_cr0) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_CR3, read_cr3()) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_CR4, guest_cr4) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_DR7, 0x400) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_EFER, rdmsr(IA32_EFER)) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_LINK_PTR, ALL_ONES) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_ACTIVITY, 0) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_INTERRUPTIBILITY, 0) != 0 { return 1; }

    sgdt(&vmx_dtr_buf);
    if vmx_w(VMCS_GUEST_GDTR_LIMIT, lw(&vmx_dtr_buf)) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_GDTR_BASE, lq(&vmx_dtr_buf + 2)) != 0 { return 1; }
    sidt(&vmx_dtr_buf);
    if vmx_w(VMCS_GUEST_IDTR_LIMIT, lw(&vmx_dtr_buf)) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_IDTR_BASE, lq(&vmx_dtr_buf + 2)) != 0 { return 1; }

    if vmx_program_guest_segs(cap) != 0 { return 1; }

    if vmx_w(VMCS_GUEST_RSP, lq(cap + CAP_GUEST_RSP)) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_RIP, lq(cap + CAP_GUEST_RIP)) != 0 { return 1; }
    if vmx_w(VMCS_GUEST_RFLAGS, lq(cap + CAP_GUEST_RFLAGS)) != 0 { return 1; }
    return 0;
}

# ---- top-level arm ---------------------------------------------------------
# Called ONLY when mon_hal_detect reports VMX usable. Brings the machine into
# root mode, builds the kernel-as-guest VMCS, and VMLAUNCHes. On success the
# guest continues at the captured RIP (the caller's return address) and this
# function "returns" inside the guest with VMXST_LAUNCHED recorded; thereafter
# every floor-disable CR write traps to vmx_exit_trampoline. On any failure it
# records the stage and returns nonzero WITHOUT having changed guest behavior.
#   cap            = capture block (boot trampoline filled the seg/base fields)
#   vmxon_pa       = identity-mapped 4 KiB VMXON region phys addr
#   vmcs_pa        = identity-mapped 4 KiB VMCS region phys addr
#   eptp_pml4_pa   = root of the identity EPT (built by the caller)
#   msr_bitmap_pa  = identity-mapped 4 KiB zeroed MSR bitmap
#   host_rsp       = stack for the monitor's exit handler
fn vmx_backend_arm(cap, vmxon_pa, vmcs_pa, eptp_pml4_pa, msr_bitmap_pa, host_rsp) {
    sq(&vmx_status, VMXST_IDLE);
    if vmx_enter_root(vmxon_pa) != 0 { return lq(&vmx_status); }
    if vmx_load_vmcs(vmcs_pa) != 0 { return lq(&vmx_status); }

    # Legalize the guest CR0/CR4 the same way root entry did, so the values we
    # program (and the read-shadows) are VMX-legal.
    let gcr0 = (read_cr0() | rdmsr(IA32_VMX_CR0_FIXED0)) & rdmsr(IA32_VMX_CR0_FIXED1);
    let gcr4 = (read_cr4() | rdmsr(IA32_VMX_CR4_FIXED0)) & rdmsr(IA32_VMX_CR4_FIXED1);

    if vmx_program_controls(eptp_pml4_pa, msr_bitmap_pa, gcr0, gcr4) != 0 {
        return lq(&vmx_status);
    }
    if vmx_program_host(cap, host_rsp) != 0 { return lq(&vmx_status); }
    if vmx_program_guest(cap, gcr0, gcr4) != 0 { return lq(&vmx_status); }

    sq(&vmx_status, VMXST_LAUNCHED);     # optimistic; reset below if launch fails
    if vmlaunch() != 0 {
        sq(&vmx_status, VMXST_LAUNCH_FAIL);
        return VMXST_LAUNCH_FAIL;
    }
    return VMXST_LAUNCHED;
}

# ---- VM-exit handler (the floor) -------------------------------------------
# A MOV-to-CRn that touches a monitor-masked bit (per vmx_program_controls)
# VM-exits here with basic reason 28 (control-register access). The handler
# DECIDES per the modeled policy: a write that would clear CR0.WP / strip CR4
# enforcement / swap CR3 to an unverified root is a floor-disable attempt and is
# REFUSED (the change is dropped); otherwise the write is applied to the real
# CRn and reflected in the read-shadow. Either way the guest instruction is
# skipped (RIP += exit instruction length) and the guest resumes via VMRESUME -
# transparently for legitimate writes, harmlessly for attacks.
const EXIT_REASON_CR_ACCESS = 28;
const EXIT_REASON_MASK = 0xFFFF;
# Exit qualification for a CR access: bits 3:0 = CR number, bits 5:4 = access
# type (0 = MOV to CR), bits 11:8 = GPR index.
const CRQ_CRNUM_MASK = 0xF;

fn vmx_handle_exit() {
    let reason = vmread(VMCS_EXIT_REASON) & EXIT_REASON_MASK;
    if reason == EXIT_REASON_CR_ACCESS {
        # A floor-relevant CR write trapped. The conservative, fail-closed floor
        # action is to DROP the change (do not propagate to the real CRn) and
        # skip the instruction: a compromised ring-0 cannot disable WP/SMEP/SMAP
        # or repoint CR3. (A future refinement consults the mon_hal_s2 policy to
        # allow benign writes; refusing all masked writes is strictly safer.)
        let len = vmread(VMCS_EXIT_INSTR_LEN);
        let rip = vmread(VMCS_GUEST_RIP);
        vmwrite(VMCS_GUEST_RIP, rip + len);
    }
    # Resume the guest. VMRESUME only returns here on failure.
    if vmresume() != 0 {
        sq(&vmx_status, VMXST_LAUNCH_FAIL);
    }
}

# ---- exit trampoline (host RIP) --------------------------------------------
# The CPU enters here on every VM-exit with host segments/CR3/RSP loaded but the
# GPRs still holding GUEST values. Save them, run the structured handler, restore
# them, and the handler's VMRESUME re-enters the guest. naked: no prologue, the
# register discipline is explicit (matches the syscall-trampoline pattern).
fn vmx_exit_trampoline() naked {
    push_reg(rax); push_reg(rcx); push_reg(rdx); push_reg(rbx);
    push_reg(rbp); push_reg(rsi); push_reg(rdi);
    push_reg(r8);  push_reg(r9);  push_reg(r10); push_reg(r11);
    push_reg(r12); push_reg(r13); push_reg(r14); push_reg(r15);
    vmx_handle_exit();
    pop_reg(r15); pop_reg(r14); pop_reg(r13); pop_reg(r12);
    pop_reg(r11); pop_reg(r10); pop_reg(r9);  pop_reg(r8);
    pop_reg(rdi); pop_reg(rsi); pop_reg(rbp); pop_reg(rbx);
    pop_reg(rdx); pop_reg(rcx); pop_reg(rax);
    # vmx_handle_exit already issued VMRESUME; if control reaches here VMRESUME
    # failed (it would not have returned into the handler otherwise) - halt the
    # monitor rather than fall through to undefined code.
    ud2();
}
