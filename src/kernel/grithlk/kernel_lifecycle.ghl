# ============================================================================
# Kernel lifecycle and free-running main loop.  ZERO-ASM.
# Owns kmain from early boot through the GUI/event/render loop. Structured
# GritHLK (was a register-exact asm shim).
#
# Build-config conditionals (ENABLE_SMAP/CET/KPTI, ENABLE_SHADOW_STACK_POC,
# FBPERF_NO_WC, GRIT_SMP, PROBE_NK_PT) are expressed with the `cfg "NAME" {..}`
# primitive, which emits the matching NASM %ifdef/%ifndef - so kmain compiles to
# the exact same per-config call sequence as the old shim. The BOOTLOG2 and SER
# debug macros are reproduced by the serdbg()/bootlog2() helpers (gated on
# ENABLE_DEBUG_SERIAL / GRIT_BOOT_DIAG_LOG via cfg), so their emitted COM1 bytes
# match the originals in every config. sti/cli/hlt are kernel intrinsics.
# ============================================================================

module "kernel_lifecycle";

unsafe kernel_priv;   # sti / cli / hlt
unsafe raw_mem;       # lb/lw/sb/sw/sq of kernel boot + main-loop state
unsafe kernel_io;     # TEMP DEBUG: outb/ind to the Bochs VBE ports (clobber detect)
unsafe implicit_extern; # extern kernel symbols + workqueue.ghl table reference

global kmain;
global device_enum_job;   # wq_job_table[4] (workqueue.ghl); dispatched by job ID
global k5_verify_job;     # wq_job_table[6] (workqueue.ghl); K5 signed-verify offload

const PAGE_TABLE_ADDR = 0x70000;   # src/include/boot_memory.inc (PROBE_NK_PT)
const GUI_READY = 1;

# Boot-stage log tag chars.
const TAG_K = 75;   # 'K'
const TAG_L = 76;   # 'L'
const D0 = 48;      # '0' (digit base)

# Kernel-resident boot / main-loop state + strings (defined elsewhere).
extern gui_initialized;       # byte
extern code_hash_armed;       # byte: 1 once all boot init done; arms PIT slot-integrity scans
extern main_loop_stage;       # byte
extern main_loop_stage_done;  # byte
extern main_loop_iters;       # dword
extern s_wcact_tag;           # "[FBPERF] wc_activate rax="
extern s_wcact_fail;          # "[FBPERF] WC activation FAILED -- halting ..."

# Frame pacer (frame_pacing.ghl): deadline-driven FPS cap + idle HLT. Replaces
# the old unconditional per-wakeup hlt(): paces the loop to target_fps / vsync_hz
# and sleeps the slack on the timer IRQ so the CPU stops busy-running hot.
extern frame_pace_reset;
extern frame_pace_activity;
extern frame_pace_wait;
extern kernel_data_segments;

# Ring-0 fault recovery wrapper (isr.asm). Runs render_frame() under a
# longjmp-style guard so a fault in the display/present path aborts the frame
# and returns here instead of freezing the OS (the ISR longjmps back to the
# wrapper's landing pad). Call this in place of render_frame() on the hot loop.
extern render_frame_guarded;

# Top-level ring-3 orphan-fault recovery (isr.asm r3guard_arm + callback_dispatch
# cb_orphan_recover). r3guard_arm is setjmp-style: returns 0 when armed, and
# "returns" non-zero when the ISR longjmps the BSP back here after an orphaned
# ring-3 fault (one with no in-flight callback slot to unwind) - which would
# otherwise park the BSP forever in l3_return_guard's cli;hlt (the app-open
# freeze). On that recovery we clear the mid-flight callback bookkeeping and
# strike the offending app, then fall straight back into the loop body so input /
# render / timers keep running. Must be called directly in kmain's frame.
extern r3guard_arm;       # () -> 0 first time, non-zero on longjmp recovery
extern cb_orphan_recover; # () clear callback state + strike the running app

# BSP kernel-liveness watchdog (watchdog.ghl, feedback_no_freeze_invariant).
# kwd_init arms it just before the loop; kwd_bsp_tick is the once-per-iteration
# progress heartbeat. The ring-0 PIT timer path (isr.asm) calls kwd_check and, on
# a wedge past the deadline, longjmps back to this loop's r3guard landing pad.
extern kwd_init;          # () arm the watchdog
extern kwd_bsp_tick;      # () bump the BSP progress heartbeat

# Runtime feature toggles (boot_features.ghl). boot_features_init parses the
# optional ESP BOOTCFG.TXT (default = everything ON) into feat_mask; feat_enabled
# is a cheap AND-test predicate (RDI = bit -> RAX 0/1) used to gate subsystem
# init and the per-frame hot path for secure-boot profiles + FB-bug bisection.
extern boot_features_init;
extern feat_on;          # feat_on(bit) -> 1 if the feature is enabled

# SMP work queue (proc/workqueue.asm): used to offload the slow device bring-up
# (xHCI enumeration + PHY link waits) onto an Application Processor so boot does
# not halt waiting for it. Plain SysV ABI: args in rdi/rsi/rdx, result in rax.
extern workqueue_submit; # (jobid, arg, prio) -> job handle (or -1 if full)
extern workqueue_wait;   # (handle) -> result; blocks until the job is done, frees it
extern workqueue_wait_timeout; # (handle, budget_ticks) -> result; bounded join, never wedges the BSP
const WQ_PRIO_HIGH   = 2;  # keep in lockstep with workqueue.ghl WQ_PRIO_HIGH
const WQ_JOB_DEVENUM = 4;  # wq_job_table index for device_enum_job (workqueue.ghl)
const WQ_JOB_K5VERIFY = 6; # wq_job_table index for k5_verify_job (workqueue.ghl)
const WQ_INVALID_H   = -1; # workqueue_submit failure (queue full) sentinel
# Device bring-up join budget (PIT ticks @ 10ms). Normal bring-up is ~0.5s (~50
# ticks); this generous ~3s ceiling exists only so a wedged driver init (xHCI /
# i2c-HID / NIC) on the worker AP can never freeze the BSP at the join below.
const DEVENUM_JOIN_BUDGET = 300;

# TEMP DEBUG: slow-motion main-loop tracer. Draws a per-call colored marker block
# directly to the FRONT framebuffer, then stalls SLOWMO_TICKS PIT ticks, so the
# 1664x262 FB clobber can be watched in slow-mo - the rightmost/last marker block
# visible when the screen garbles is the call that triggered it.
extern fb_addr;          # qword: front framebuffer base
extern scr_pitch;        # dword: bytes per row
extern tick_count;       # qword: PIT tick (100Hz -> 10ms/tick)
const SLOWMO_TICKS = 0;   # full speed (the clobber only races at realtime)
const VBE_IDX_PORT  = 0x1CE;
const VBE_DATA_PORT = 0x1CF;
const VBE_XRES_OK   = 0x41;    # DISPI ENABLE reg (idx 4) = LFB|ENABLED; clobber clears it

data clob_flag: 1 = 0;    # latched once the res-change is detected

# Main-loop service scheduler. A quiet desktop should not run the full render /
# USB / net / I2C / battery stack on every BSP pass. These stamps split the loop
# into small tick-driven services; device-specific routines still self-throttle
# internally, but they are no longer all on the hot path.
data ml_last_input_tick: 1 x 8 = 0;
data ml_last_i2c_tick: 1 x 8 = 0;
data ml_last_serial_tick: 1 x 8 = 0;
data ml_last_net_tick: 1 x 8 = 0;
data ml_last_render_tick: 1 x 8 = 0;
data ml_last_battery_tick: 1 x 8 = 0;
data ml_active_until_tick: 1 x 8 = 0;
data ml_pointer_dirty: 1 x 1 = 0;

const KEV_INPUT = 1;                # keyboard/PS2/touchpad input IRQ
const KEV_USB   = 2;                # xHCI event IRQ
const ML_INPUT_FALLBACK_PERIOD = 1;  # legacy serial/USB fallback (~10 ms)
const ML_I2C_IDLE_PERIOD = 50;      # rare fallback only if touchpad IRQ is absent
const ML_ACTIVITY_TICKS = 25;       # active input burst window (~250 ms)
const ML_NET_IDLE_PERIOD = 10;      # idle NIC/DHCP service (~100 ms)
const ML_BATTERY_PERIOD = 100;      # battery service (~1 s; driver also throttles)

# Feature bits - keep in lockstep with boot_features.ghl / boot_memory.inc.
const FEAT_FRAME_PACING = 4;
const FEAT_MOUSE_INIT   = 8;
const FEAT_HID_INIT     = 16;
const FEAT_USBHID_INIT  = 1024;   # usb_hid_init() ALONE - sub-gate of FEAT_HID_INIT
const FEAT_USBNIC_INIT  = 2048;   # rtl8156_init() USB NIC probe
const FEAT_DEBUG_OVERLAY = 512;   # per-frame usb_debug_overlay() draw
const FEAT_DISPLAY_INIT = 64;
const FEAT_FBPERF_WC    = 128;
const FEAT_FX_BENCH     = 256;

# TEMP DEBUG: periodic counter dump to find a value that grows with mouse
# movement and never decreases (suspected unbounded accumulator behind the
# mouse-driven FB clobber). Printed every 64 frames as one COM1 line.
extern mouse_x;               # dword: cursor X (should stay 0..scr_width-1)
extern mouse_y;               # dword: cursor Y (should stay 0..scr_height-1)
extern dirty_count;           # dword: pending dirty rects (should reset each flush)
extern rtl8156_active;        # byte: real USB RTL8156 NIC present/usable
# Per-core raster target table (constants.inc RTGT_*). This diag runs on the BSP
# (dense core 0), whose slot is at table offset 0 - so reading the core-0 slot
# reports the BSP compositor's live target.
extern raster_target_tbl;     # SMP_MAX_CORES x 32-byte slots
extern scr_pitch_q;           # qword: live framebuffer pitch

fn dbg_lbl3(a, b) {
    call svg_dump_putc(al: a);
    call svg_dump_putc(al: b);
    call svg_dump_putc(al: 61);   # '='
}
fn dbg_field(a, b, val) {
    dbg_lbl3(a, b);
    call ser_print_hex64(rdi: val);
    call svg_dump_putc(al: 32);   # ' '
}
fn dbg_counters() {
    dbg_field(77, 88, lw(&mouse_x));               # MX
    dbg_field(77, 89, lw(&mouse_y));               # MY
    dbg_field(68, 67, lw(&dirty_count));           # DC
    dbg_field(82, 65, lq(&raster_target_tbl + 0));   # RA (RTGT_ADDR)
    dbg_field(82, 80, lq(&raster_target_tbl + 16));  # RP (RTGT_PITCH)
    dbg_field(82, 72, lw(&raster_target_tbl + 12));  # RH (RTGT_HEIGHT)
    dbg_field(83, 80, lq(&scr_pitch_q));           # SP
    call svg_dump_putc(al: 13);
    call svg_dump_putc(al: 10);
}

# ENABLE_DEBUG_SERIAL-gated single COM1 byte (the old SER macro).
fn serdbg(ch) {
    cfg "ENABLE_DEBUG_SERIAL" {
        call svg_dump_putc(al: ch);
    }
}

# Boot stage marker. Now always-on: routes to boot_mark (boot_timing.ghl), which
# emits the live "[c1c2]\r\n" marker over COM1 AND records a TSC timestamp for the
# end-of-boot timing report. (Formerly a GRIT_BOOT_DIAG_LOG-gated emit-only macro;
# the timing table makes the markers cheap enough to keep on in every build.)
fn bootlog2(c1, c2) {
    boot_mark(c1, c2);
}

# TEMP DEBUG: stall SLOWMO_TICKS PIT ticks (HLT-friendly; interrupts are on).
fn slowmo_delay() {
    let s = lq(&tick_count);
    while (lq(&tick_count) - s) < SLOWMO_TICKS { hlt(); }
}

# TEMP DEBUG: read Bochs VBE x-res register (index 1) via the I/O ports.
fn vbe_read(idx) {
    outw(VBE_IDX_PORT, idx);
    return inw(VBE_DATA_PORT) & 65535;
}

# Return 0 if all key DISPI regs are at their expected 1920x1200 values, else
# return the index (1..6) of the FIRST register that deviates.
fn vbe_bad_idx() {
    if vbe_read(1) != 0x780 { return 1; }   # XRES
    if vbe_read(2) != 0x4b0 { return 2; }   # YRES
    if vbe_read(3) != 0x20  { return 3; }   # BPP
    if vbe_read(4) != 0x41  { return 4; }   # ENABLE|LFB
    if vbe_read(6) != 0x780 { return 6; }   # VIRT_WIDTH
    return 0;
}

# TEMP DEBUG: emit "X<ch>=<xres>\r\n" - labeled VBE x-res probe at a boot point.
fn xrdump(ch) {
    call svg_dump_putc(al: 88);   # 'X'
    call svg_dump_putc(al: ch);
    call svg_dump_putc(al: 61);   # '='
    call ser_print_hex64(rdi: vbe_bad_idx());   # 0 = all DISPI regs nominal
    call svg_dump_putc(al: 13);
    call svg_dump_putc(al: 10);
}

# TEMP DEBUG: emit "CLB=<culprit> XR=<bad_dispi_index>\r\n" on COM1.
fn clob_report(culprit, xr) {
    call svg_dump_putc(al: 67);   # 'C'
    call svg_dump_putc(al: 76);   # 'L'
    call svg_dump_putc(al: 66);   # 'B'
    call svg_dump_putc(al: 61);   # '='
    call ser_print_hex64(rdi: culprit);
    call svg_dump_putc(al: 32);   # ' '
    call svg_dump_putc(al: 88);   # 'X'
    call svg_dump_putc(al: 82);   # 'R'
    call svg_dump_putc(al: 61);   # '='
    call ser_print_hex64(rdi: xr);
    call svg_dump_putc(al: 13);
    call svg_dump_putc(al: 10);
}

# TEMP DEBUG: per-call tracer. (1) If the PREVIOUS action just clobbered the VBE
# mode, latch + report which action it was. (2) Serial-tag this action (until the
# clobber, to keep the log readable). (3) Paint the marker block. (4) Stall.
fn slowmo_step(idx) {
    # Was the FB-clobber slow-mo tracer: per-call colored marker block + serial
    # tag + SLOWMO_TICKS stall. The clobber is found (off-screen flip wild write)
    # and ring-0 fault recovery is in place, so this is now a no-op at full speed.
    return;
}

fn ml_mark_active(now) {
    sq(&ml_active_until_tick, now + ML_ACTIVITY_TICKS);
    frame_pace_activity();
}

fn ml_input_service(now, events) {
    let before_x = lw(&mouse_x);
    let before_y = lw(&mouse_y);
    let before_b = lb(&mouse_buttons);
    let mouse_polled = 0;

    if (events & KEV_USB) != 0 {
        usb_poll_mouse();
        mouse_polled = 1;
    }

    # The I2C touchpad poll is a blind bus transaction. During active pointer
    # movement we rely on the APIC touchpad IRQ path. This rare fallback exists
    # only for firmware that did not expose a usable touchpad IRQ.
    if now - lq(&ml_last_i2c_tick) >= ML_I2C_IDLE_PERIOD {
        i2c_hid_poll();
        sq(&ml_last_i2c_tick, now);
        mouse_polled = 1;
    }

    keyboard_repeat_tick();
    if (events & KEV_INPUT) != 0 || keyboard_available() != 0 {
        process_keyboard();
        while keyboard_available() != 0 {
            process_keyboard();
        }
    }
    if lb(&scene_dirty) != 0 { ml_mark_active(now); }

    if now - lq(&ml_last_serial_tick) >= ML_INPUT_FALLBACK_PERIOD {
        sq(&ml_last_serial_tick, now);
        serial_poll_command();
        # USB legacy fallback while INTx/MSI routing is absent or broken. When
        # xHCI IRQs are firing, KEV_USB handles this path immediately.
        if (events & KEV_USB) == 0 { usb_poll_mouse(); mouse_polled = 1; }
    }
    if mouse_polled != 0 || (events & KEV_INPUT) != 0 { process_mouse(); }
    if lw(&mouse_x) != before_x { ml_mark_active(now); sb(&ml_pointer_dirty, 1); }
    if lw(&mouse_y) != before_y { ml_mark_active(now); sb(&ml_pointer_dirty, 1); }
    if lb(&mouse_buttons) != before_b { ml_mark_active(now); }
    if lb(&scene_dirty) != 0 { ml_mark_active(now); }
}

fn ml_net_service(now, events) {
    let period = ML_NET_IDLE_PERIOD;
    if (events & KEV_USB) != 0 { period = 0; }
    let usbnic_on = feat_on(FEAT_USBNIC_INIT);
    if usbnic_on != 0 && lb(&rtl8156_active) == 1 {
        if lb(&rtl8156_dhcp_state) == 1 { period = 1; }
        if lb(&rtl8156_dhcp_state) == 2 { period = 1; }
    }
    if usbnic_on != 0 && lb(&rtl8156_ping_async_state) == 1 { period = 1; }
    if now - lq(&ml_last_net_tick) < period { return; }
    sq(&ml_last_net_tick, now);

    if usbnic_on != 0 && lb(&rtl8156_active) == 1 { rtl8156_dhcp_pump(); }
    rtl8139_dhcp_pump();
    net_nic_poll_rx();
}

fn ml_render_due(now) {
    if lb(&scene_dirty) != 0 { return 1; }
    # NOTE: pointer-only motion no longer forces a render frame. The cursor is
    # painted directly from the input path (input_dispatch.ghl pm_idle_cursor),
    # which tracks at poll rate and survives a faulting/aborted render frame;
    # forcing a render here too would double-draw the cursor (flicker).
    if lq(&wm_drag_window_id) != -1 { return 1; }
    let usbnic_on = feat_on(FEAT_USBNIC_INIT);
    if usbnic_on != 0 && lb(&rtl8156_active) == 1 {
        if lb(&rtl8156_dhcp_state) == 1 { return 1; }
        if lb(&rtl8156_dhcp_state) == 2 { return 1; }
    }
    if usbnic_on != 0 && lb(&rtl8156_ping_async_state) == 1 { return 1; }
    return 0;
}

fn ml_battery_service(now) {
    if now - lq(&ml_last_battery_tick) < ML_BATTERY_PERIOD { return; }
    sq(&ml_last_battery_tick, now);
    battery_poll();
}

# Kernel entry: early CPU/memory policy, descriptors + security init, drivers,
# GUI bring-up, then the free-running event/render loop.
# ----------------------------------------------------------------------------
# Asynchronous device bring-up. USB HID, i2c HID, the RTL8156 2.5G NIC, MMIO
# capability registration and mouse_init are batched into ONE work-queue job so
# the slow xHCI enumeration and PHY link waits (~0.5 s on real hardware) run on
# an Application Processor while the BSP brings up the GUI and paints the first
# frame. The entire USB/net sequence stays on a single core (the AP); the BSP
# touches no USB/net/HID state between dispatch and the join before kernel
# lockdown, so the not-SMP-safe drivers are serialised by construction (no lock
# needed). On a single-core build workqueue_submit runs this inline, so boot
# degrades cleanly to the old in-order behaviour. Boot no longer halts here.
#
# Runs with the same feature gating as the old inline path (FEAT_HID_INIT /
# FEAT_MOUSE_INIT). No boot_mark() calls inside the job: that table is owned by
# the BSP and must not be written from two cores at once.
fn device_enum_job(arg) {
    # usb_hid_init is gated by BOTH the umbrella HID gate AND a dedicated
    # FEAT_USBHID_INIT sub-gate so the USB-HID path can be isolated from the
    # i2c-HID (touchpad) path on real hardware WITHOUT a rebuild: put
    # `usbhid=0` in \EFI\BOOT\BOOTCFG.TXT to skip ONLY usb_hid_init while still
    # running i2c_hid_init below. (usb_hid_init runs first, so if it is the
    # hanging path, skipping it lets the touchpad bring-up be tested alone.)
    if feat_on(FEAT_HID_INIT) != 0 {
        if feat_on(FEAT_USBHID_INIT) != 0 {
            usb_hid_init();
        }
    }
    usb_hid_flush_log();
    if feat_on(FEAT_HID_INIT) != 0 {
        i2c_hid_init();
    }
    # Re-prime slot1 interrupt ring (the NIC flush drains the mouse's events).
    usb_hid_requeue_slot1_reads();
    # RTL8156 USB 2.5G NIC. rtl8156_init brackets its port walk with HID-slot
    # ownership guards (see rtl8156.asm); on failure (no device / no link) it
    # leaves rtl8156_active = 0 and the emulated rtl8139 path stays the fallback.
    if feat_on(FEAT_USBNIC_INIT) != 0 {
        rtl8156_init();
    } else {
        sb(&rtl8156_active, 0);
        sb(&rtl8156_dhcp_bound, 0);
        sb(&rtl8156_dhcp_state, 4);
        sb(&rtl8156_ping_async_state, 0);
    }
    usb_hid_requeue_slot1_reads();
    # Declare each driver's MMIO region now that BARs are resolved (§8).
    mmio_drv_caps_init();
    if feat_on(FEAT_MOUSE_INIT) != 0 {
        mouse_init();
    }
    # EC battery probe (LPC/ACPI ports) - independent of USB, folded into the
    # async job so its ~0.1s EC handshake also stays off the boot critical path.
    battery_init();
    return 0;
}

# K5 Ed25519 boot-chain verification, packaged as a work-queue job so it runs
# on an Application Processor (overlapping the BSP's GUI bring-up) instead of
# serialising boot. Returns the aggregate verdict (0 ok / PANIC_* code); it
# NEVER panics here - panicking on an AP would halt only that core and let the
# BSP proceed to launch apps, which would be a security hole. The BSP enforces
# the verdict fail-closed in k5_verify_join. envelope_gate.ghl owns the logic.
fn k5_verify_job(arg) {
    return k5_signed_verify_all();
}

# BSP-side join: wait for the K5 verify job and FAIL CLOSED on any nonzero
# verdict (or, if the queue was full so the job ran inline as -1, run it here).
# Called before the shell app launches, so no unsigned/tampered artifact can
# run: a bad verdict panics the BSP. Then the persistent anti-rollback floors
# the job ratcheted in memory are written back (disk I/O stays on the BSP).
fn k5_verify_join(h) {
    let rc = 0;
    if h == WQ_INVALID_H {
        rc = k5_signed_verify_all();      # queue full: run inline, still fail-closed
    } else {
        rc = workqueue_wait(h);
    }
    if rc != 0 {
        kernel_panic_canary(rc, &k5_verify_job, rc);
    }
    floor_persist(gate_time_now());       # persist ratcheted floors + clock high-water
    return 0;
}

fn kmain() {
    bootlog2(TAG_K, D0 + 0);          # K0: kmain entered
    memory_init();
    # Parse the optional ESP BOOTCFG.TXT into feat_mask BEFORE any gated
    # subsystem runs. Default (no file) = everything ON; disabled features are
    # logged "[FEAT] <name>=off" on COM1.
    boot_features_init();
    bootlog2(TAG_K, D0 + 1);          # K1: memory/early CPU policy done

    # Kernel/user boundary hardening: CR4.SMEP/SMAP now that PTE.U bits are live.
    cfg "ENABLE_SMAP" { smap_smep_init(); }
    # CET inventory (cheap CPUID probe, always run; cet_enable below is gated).
    cet_detect();

    app_blob_init();                  # read loaded APPS.BIN pointer
    bootlog2(TAG_K, D0 + 2);          # K2: app blob extent initialized
    if feat_on(FEAT_DISPLAY_INIT) != 0 {
        display_init();
        boot_mark(68, 105);           # "Di" display_init
        display_flip();
        boot_mark(68, 102);           # "Df" display_flip
    }
    # TEMP DEBUG: baseline VBE x-res right after display setup. If X0=0x780 the
    # read path works, so any later non-0x780 probe is a real clobber.
    xrdump(48);   # "X0" after display_init/flip

    cfg !"RELEASE_BUILD" {
        xml_self_test();
        raster_self_test();
    }
    bootlog2(TAG_K, D0 + 3);          # K3: display ready; debug self-tests passed when enabled

    idt_init();
    boot_mark(73, 100);               # "Id" idt_init
    gdt64_init();
    boot_mark(71, 100);               # "Gd" gdt64_init
    tss_init();
    boot_mark(84, 115);               # "Ts" tss_init
    kernel_canary_init();
    boot_mark(67, 121);               # "Cy" kernel_canary_init
    slot_cap_hmac_init();             # seed per-slot cap-mask HMACs (canary final)
    boot_mark(67, 104);               # "Ch" slot_cap_hmac_init
    nx_mem_key_ensure();              # Track 4 Part B: draw the per-boot ephemeral memory key (canary final)
    nx_secret_mask_seed();            # Track 4 Part B item 4: derive the per-boot secret-whitening mask from nx_mem_key
    nx_atrest_selftest();             # Track 4 Part B item 2: round-trip the at-rest cipher under the live key (fail-soft)
    nx_atrest_ext_selftest();         # Track 4 Part B items 5/6/8: scrub-scratch / poison-fill / fingerprint de-correlation (fail-soft)
    nx_mem_key_rekey_selftest();      # Track 4 Part B item 7: forward-secure rolling re-key (fail-soft, leaves one legit rotation)
    nx_track4_selftest_report();      # surface the Part B self-test results on COM1 (debug builds): [T4ST a=1 x=1 r=1]
    boot_mark(78, 52);                # "N4" Track-4 nx self-tests done
    bootlog2(TAG_K, D0 + 4);          # K4: descriptors/canary/cap HMAC ready

    measured_boot_init();             # fold boot stages -> mb_digest
    boot_mark(77, 68);                # "MD": measured_boot_init done (isolated)
    app_manifest_verify();            # signed per-app integrity table
    boot_mark(65, 109);               # "Am" app_manifest_verify
    app_segment_verify(0);            # APP_SEG_COMMON: launch glue/common code
    boot_mark(65, 115);               # "As" app_segment_verify
    # (Track 7) The legacy whole-blob symmetric HMAC rollback check was removed:
    # its key shipped in the image and the blob is fully covered by the Ed25519
    # envelope + per-segment SHA-256 below.
    # Track 2 boot-chain call sites (envelope_gate.ghl): the integrity table
    # verified above must ALSO arrive inside a threshold-Ed25519-signed
    # envelope (SYSSIG.ENV, fail-closed panic), and any staged update artifact
    # (KUPDATE.ENV) is admitted/rejected only through the same signed gate.
    gate_device_id_init();        # REAL per-machine device id (CPUID-derived),
                                  # bound before any TARGET_DEVICE admission
    boot_mark(71, 105);           # "Gi" gate_device_id_init
    floor_store_load();           # persistent anti-rollback floors (fail-soft
                                  # to the build-time floors without media)
    boot_mark(70, 108);           # "Fl" floor_store_load
    gate_time_set(floor_time_high()); # cross-boot clock high-water first, so a
                                  # rolled-back RTC can't rewind the verifier
    gate_time_set(rtc_now_unix()); # then the live CMOS sample (ratchet: max wins)
    boot_mark(71, 116);           # "Gt" gate_time_set (clock high-water + RTC)
    # The EXPENSIVE Ed25519 boot-chain verifications (SYSSIG + KERNEL envelopes,
    # plus the optional staged update/quorum/class artifacts) are NOT run here on
    # the BSP critical path. They are dispatched as one work-queue job onto an
    # Application Processor just after smp_ap_startup below (k5_verify_job) and
    # JOINED fail-closed before the shell launches (k5_verify_join), so their
    # cost overlaps GUI bring-up + the device-enum join instead of serialising
    # boot. Only the cheap verifier-context setup above (device id, persistent
    # floors, RTC clock) and the BSP's own SHA work (measured boot / manifest /
    # segment, done just above) run here, BEFORE dispatch - so the offloaded job
    # has exclusive use of the single-threaded SHA-256/Ed25519 scratch. The
    # fail-closed guarantee is unchanged: no app runs until SYSSIG has
    # authenticated the per-app integrity table on this boot.
    bootlog2(TAG_K, D0 + 5);          # K5: verifier context ready; crypto offloaded

    l3_install_syscall_stack_pt();    # per-slot syscall-stack guard pages
    boot_mark(83, 115);               # "Ss" syscall-stack guard PTs
    cfg "ENABLE_CET" {
        cet_enable();                 # CET status only; hardware SHSTK arming is scoped out
        cet_log_state();
    }
    cfg "ENABLE_KPTI" {
        kpti_init();                  # build + arm the user-view CR3
        kpti_log_state();
    }
    cfg "ENABLE_SHADOW_STACK_POC" {
        shadow_stack_poc_run();       # fail-closed shadow-stack proof harness
    }
    syscall_init();
    boot_mark(83, 105);               # "Si" syscall_init
    # XSCC: empirical cross-syscall callee-saved contract self-test. Loads
    # sentinels into rbx/rbp/r12-r15, runs the SYSRET exit-tail callees
    # (l3_apply_wx_policy + SANITIZE_SEG_USER_EXIT) and checks survival - the
    # one residual that decides whether the regalloc gate can keep app values in
    # r12-r14 across a syscall. Emits "XSCC A=.. B=.. -> PASS|FAIL" on COM1.
    # Debug builds only (the verdict is build-config-independent: same callees).
    cfg !"RELEASE_BUILD" {
        cross_syscall_contract_selftest();
    }
    bootlog2(TAG_K, D0 + 6);          # K6: syscall path initialized

    scheduler_init();
    boot_mark(83, 99);                # "Sc" scheduler_init
    pic_init();
    boot_mark(80, 99);                # "Pc" pic_init
    pit_init();
    boot_mark(80, 116);               # "Pt" pit_init
    # Register the LAPIC MMIO page before sti so the first PIT IRQ's apic_eoi
    # finds a registered region instead of fail-closed panicking.
    mmio_register_lapic();
    boot_mark(77, 108);               # "Ml" mmio_register_lapic
    bootlog2(TAG_K, D0 + 7);          # K7: scheduler/timer/MMIO pre-IRQ done

    # NOTE: interrupts stay DISABLED across the FAT16 cache fill. fat16_init's
    # FAT/root-directory caches are sized by on-disk (ring-3-shaped) fields and
    # bracketed by a kernel_canary guard; a PIT IRQ landing mid-fill was the
    # intermittent early-boot "CANARY 0" panic (~1-in-3). ata_read_sectors no
    # longer needs PIT ticks here - its wait helpers carry a tick-free spin-count
    # fallback - so the splash/skip-key need for early ticks is gone and sti is
    # deferred until after the fragile storage init.
    ramdisk_init();                   # register UEFI DATA.IMG before fat16_init
    boot_mark(82, 68);                # "RD": ramdisk registered
    fat16_init();                     # load BOOTANIM.NBA
    boot_mark(70, 70);                # "FF": fat16 cache fill done (storage isolated)
    # Enable interrupts once storage caches are filled + guarded.
    sti();
    boot_mark(83, 116);               # "St" sti (interrupts live)
    keyboard_init();
    boot_mark(75, 98);                # "Kb" keyboard_init
    bootlog2(TAG_K, D0 + 8);          # K8: storage/input ready

    # Boot splash is OFF by default (deterministic boot). Opt in at build time
    # with build_uefi.ps1 -BootAnim, which defines GRIT_BOOT_ANIM for NASM.
    cfg "GRIT_BOOT_ANIM" {
        boot_anim_play();             # boot splash (green console stays hidden)
    }
    bootlog2(TAG_K, D0 + 9);          # K9: boot animation returned

    acpi_init();
    boot_mark(65, 67);                # "AC": acpi_init
    apic_init();
    boot_mark(65, 80);                # "AP": apic_init
    ioapic_init();
    boot_mark(73, 79);                # "IO": ioapic_init
    spi_init();
    boot_mark(83, 80);                # "SP": spi_init
    if feat_on(FEAT_HID_INIT) != 0 {
        spi_hid_init();
    }
    boot_mark(83, 72);                # "SH": spi_hid_init
    # Prefer the paravirtual NIC when QEMU exposes it. RTL8139 remains compiled
    # and initialized as a compatibility fallback; the NIC dispatcher chooses
    # VirtIO by priority when both are present.
    virtio_net_init();
    rtl8139_init();
    boot_mark(82, 57);                # "R9": rtl8139_init

    # USB HID / i2c / RTL8156 NIC bring-up + MMIO caps + mouse_init no longer run
    # synchronously here - they used to block boot ~0.5 s on xHCI enumeration and
    # PHY link. They now run asynchronously on an SMP worker (device_enum_job),
    # dispatched just after the work queue + APs come up below and joined before
    # kernel lockdown. See device_enum_job and the workqueue_submit/_wait calls.

    # ---- FBPERF write-combining arm + activate ----
    # MUST run BEFORE smp_ap_startup() below. fbperf_wc_activate patches the
    # framebuffer leaf PTE to select PAT slot 1 (WC) and reloads CR3 to flush
    # only the BSP's TLB - it does NOT shoot down AP TLBs. If the APs were
    # already running (and especially if one had already touched the FB and
    # cached a TLB entry with the OLD caching attribute), the FB blit job
    # (render_flip_job, dispatched to an AP) could write the framebuffer under a
    # stale/mismatched memory type while the BSP sees WC - aliased memory types
    # on the same physical page, which the Intel SDM (Vol 3A 11.12.4) leaves
    # undefined (tearing / stale pixels). Activating here, before any AP exists,
    # makes every AP walk the already-patched PTE fresh as it comes up, and the
    # AP trampoline programs IA32_PAT to the same canonical layout
    # (apic.asm ap_long_mode_init) so slot 1 = WC on every core. No cross-core
    # TLB shootdown or stale-type window is possible. QEMU TCG hid this race
    # (serialized vCPUs + ignored PAT memory types); real SMP hardware exposed it.
    serdbg(97);                       # 'a'
    fbperf_init();
    serdbg(98);                       # 'b'
    cfg !"RELEASE_BUILD" {
        fbperf_serial_dump();         # snapshot 1: pre-activation
    }
    serdbg(99);                       # 'c'

    # Single-boot WC arm + activate. wc: 0=ok, <0=failed. FBPERF_NO_WC keeps the
    # firmware mapping (no arm/activate) and leaves wc=0 (the old `xor eax,eax`).
    let wc = 0;
    cfg !"FBPERF_NO_WC" {
        if feat_on(FEAT_FBPERF_WC) != 0 {
            fbperf_arm_wc();
            wc = fbperf_wc_activate();
        }
    }
    serial_puts(&s_wcact_tag);
    call ser_print_hex64(rdi: wc);
    serial_crlf();
    if wc != 0 {
        serial_puts(&s_wcact_fail);
        serial_crlf();
        fbperf_serial_dump();         # re-dump to show the failing fb_pte_level
        cli();
        while 1 != 0 { hlt(); }       # halt: do not continue blind
    }

    serdbg(100);                      # 'd'
    fbperf_init();                    # refresh page-walk + MSR snapshots
    cfg !"RELEASE_BUILD" {
        fbperf_serial_dump();         # snapshot 2: post-activation
    }
    serdbg(101);                      # 'e'

    boot_mark(70, 66);                # "FB": fbperf arm/activate + dumps done

    # SMP work queue must be initialised before the APs are started. The APs are
    # only brought up AFTER the FB WC mapping above is fully activated, so the
    # first FB blit an AP ever runs already observes the WC PTE + canonical PAT.
    workqueue_init();
    cfg "GRIT_SMP" { smp_ap_startup(); }
    cfg !"RELEASE_BUILD" {
        workqueue_selftest();
    }
    bootlog2(TAG_L, D0 + 0);          # L0: driver/SMP workqueue init done

    # Offload the slow device bring-up now that the APs are live. On multicore a
    # worker runs it while the BSP continues to the GUI below; on single-core
    # workqueue_submit executes it inline here (cleanly degrades to in-order boot).
    let dev_job = workqueue_submit(WQ_JOB_DEVENUM, 0, WQ_PRIO_HIGH);
    boot_mark(68, 74);                # "DJ": device-enum job dispatched (async)

    # Dispatch the K5 Ed25519 boot-chain verification onto another AP now that
    # the workqueue + APs are up. It runs in parallel with the device-enum job
    # and the BSP's GUI bring-up below, and is JOINED fail-closed (k5_verify_join)
    # before the shell launches. On single-core this runs inline here (correct,
    # just not overlapped). While it runs the BSP touches no SHA-256/Ed25519
    # state, so the single-threaded crypto scratch has one user.
    let k5_job = workqueue_submit(WQ_JOB_K5VERIFY, 0, WQ_PRIO_HIGH);
    boot_mark(75, 53);                # "K5": signed-verify job dispatched (async)

    perfdiag_init();
    boot_mark(80, 100);               # "Pd" perfdiag_init

    # mouse_init + battery_init now run inside the async device-enum job (USB HID
    # path + EC probe), so the BSP goes straight from FBPERF to GUI bring-up.
    render_init();
    boot_mark(82, 105);               # "Ri" render_init
    cursor_init();
    boot_mark(67, 105);               # "Ci" cursor_init
    wm_init();
    boot_mark(87, 77);                # "WM": render/cursor/wm init

    sb(&gui_initialized, GUI_READY);
    bootlog2(TAG_L, D0 + 1);          # L1: GUI initialized

    cpu_acct_init();
    boot_mark(67, 97);                # "Ca" cpu_acct_init
    xrdump(49);   # "X1" right BEFORE the first render_frame
    # The first paint is just as hardware-facing as steady-state presents. Keep
    # it inside the ring-0 display fault guard too, otherwise one bad LFB store
    # is iretq-retried forever before the input loop can ever start.
    render_frame_guarded();
    xrdump(50);   # "X2" right AFTER the first render_frame
    bootlog2(TAG_L, D0 + 2);          # L2: first frame rendered

    # FBPERF deterministic bench: 64 back-to-back forced full flips. This is a
    # pure diagnostic (WC was already armed/activated above); it added ~0.24s to
    # boot, so it is now debug-only. Release boots skip it entirely.
    cfg !"RELEASE_BUILD" {
        if feat_on(FEAT_FX_BENCH) != 0 {
            let bn = 64;
            while bn > 0 {
                display_flip();
                bn = bn - 1;
            }
            boot_mark(70, 88);        # "FX": 64-flip FBPERF bench done
        }
    }

    # Join the async device-enumeration job before sealing the kernel. All driver
    # MMIO/BAR setup must be done before lockdown + nk page-table protection, and
    # the main loop must not start polling HID while a worker is still touching
    # the USB path. This is the only place the BSP waits on the job; by now its
    # ~0.5 s overlapped the GUI bring-up + first frame above.
    # BOUNDED join (NO-FREEZE invariant): device bring-up must never wedge boot. If
    # a driver init hangs on its worker AP (real-HW xHCI/i2c-HID waits that QEMU
    # never exercises), the deadline fires - tick_count keeps advancing because the
    # BSP's interrupts are live here - and we proceed to a live desktop with that
    # device simply absent, instead of spinning the BSP forever. The unreaped slot
    # leak (one job) is the deliberate price; see workqueue_wait_timeout.
    workqueue_wait_timeout(dev_job, DEVENUM_JOIN_BUDGET);
    boot_mark(68, 87);                # "DW": device-enum job joined (or bounded-timeout)

    # Join the K5 Ed25519 verification job: FAIL CLOSED on any bad verdict, then
    # persist the ratcheted anti-rollback floors. This MUST complete before the
    # shell launches below - no app runs until SYSSIG has authenticated the
    # per-app integrity table this boot. By now its cost overlapped the device
    # join + GUI bring-up + first frame, so the BSP rarely waits here.
    k5_verify_join(k5_job);
    boot_mark(75, 87);                # "KW": K5 signed-verify job joined

    # Debug-only one-shot PCI/xHCI probe for the overlay. Keep kernel_io/MMIO
    # out of the per-frame overlay draw path and run it before lockdown.
    cfg "ENABLE_DEBUG_SERIAL" {
        if feat_on(FEAT_DEBUG_OVERLAY) != 0 {
            usb_debug_overlay_prime();
        }
    }

    # Read-only kernel after init (§9): lock .text PDEs + CR0.WP. Last write to
    # .text has already happened, so any subsequent kernel code write now #PFs.
    kernel_lockdown_ro();
    bootlog2(TAG_L, D0 + 3);          # L3: kernel lockdown complete

    # Nested-kernel monitor phase 2: map the page tables read-only (only the
    # audited monitor window may mutate a mapping now).
    nk_protect_page_tables();

    # Snapshot each hardening feature's runtime state for the Settings Security
    # tab (read-only; a feature that failed to engage is reported, not fatal).
    security_status_init();
    bootlog2(TAG_L, D0 + 4);          # L4: security status snapshot done

    # Emit the per-stage boot timing report over COM1 ([BOOTTIME]..[/BOOTTIME]).
    # All stage timestamps are captured by now; this is the single dump point.
    boot_timing_report();

    cfg "PROBE_NK_PT" {
        # One-shot negative test: an un-bracketed supervisor write to the now
        # read-only PML4 page must #PF, proving the protection is live.
        serdbg(78); serdbg(75); serdbg(80); serdbg(82); serdbg(66);  # "NKPRB"
        serdbg(13); serdbg(10);
        sq(PAGE_TABLE_ADDR, 0);       # expect ring-0 #PF here
    }

    # Keep the PIT-time slot code-hash verifier disabled in this build. It is
    # unsafe with the current KASLR/syscall-stack layout and was taking a
    # recoverable #GP on every timer tick, pinning CPU and starving GUI
    # presentation. Boot-time manifest/signature checks above remain enforced.
    sb(&code_hash_armed, 0);

    # Seed the frame pacer so the first iteration bases its deadline on "now".
    frame_pace_reset();

    xrdump(51);   # "X3" right BEFORE entering the main loop

    # Arm the kernel-liveness watchdog now that the top-level r3guard landing pad
    # is about to be armed each iteration. From here a wedged BSP main loop is
    # force-recovered by the ring-0 PIT timer path instead of freezing the OS.
    kwd_init();

    # ---- free-running main loop ----
    while 1 != 0 {
        kernel_data_segments();

        # Top-level orphan-ring-3-fault landing pad. Re-armed every iteration; a
        # longjmp back here (r3guard_arm returns non-zero) means a ring-3 fault was
        # recovered instead of freezing the BSP - clean up the interrupted callback
        # state + strike the app, then continue the loop.
        if r3guard_arm() != 0 {
            cb_orphan_recover();
        }
        kwd_bsp_tick();          # progress heartbeat: proves the loop is iterating
        sb(&main_loop_stage, 1);
        cpu_acct_idle_end();
        sb(&main_loop_stage_done, 1);

        if lb(&gui_initialized) == GUI_READY {
            let now = lq(&tick_count);
            let events = atomic_xchg(&kernel_event_flags, 0);
            if events != 0 { ml_mark_active(now); }

            if events != 0 || now - lq(&ml_last_input_tick) >= ML_INPUT_FALLBACK_PERIOD {
                sq(&ml_last_input_tick, now);
                sb(&main_loop_stage, 3);
                slowmo_step(1);  ml_input_service(now, events);
                sb(&main_loop_stage_done, 3);
            }

            sb(&main_loop_stage, 4);
            slowmo_step(2);  ml_net_service(now, events);
            sb(&main_loop_stage_done, 4);

            if ml_render_due(now) != 0 {
                sq(&ml_last_render_tick, now);
                sb(&main_loop_stage, 2);
                render_frame_guarded();
                sb(&ml_pointer_dirty, 0);
                sb(&main_loop_stage_done, 2);
            }

            sb(&main_loop_stage, 6);
            slowmo_step(8);  ml_battery_service(now);
            sb(&main_loop_stage_done, 6);

            sw(&main_loop_iters, lw(&main_loop_iters) + 1);

            # Diagnostic-only: dump suspect counters once every 64 scheduled
            # loop passes when boot diagnostics are explicitly enabled. Keeping
            # this on in every debug build floods COM1 and directly limits
            # interactive FPS.
            cfg "GRIT_BOOT_DIAG_LOG" {
                if (lw(&main_loop_iters) & 63) == 0 { dbg_counters(); }
            }

            cpu_acct_work_end();

            # Pace the GUI loop to the configured display target. Input routing
            # stays in ml_input_service so cursor save/restore and WM hit tests
            # happen in one ordered compositor path.
            if feat_on(FEAT_FRAME_PACING) != 0 {
                frame_pace_wait();
            } else {
                sti();
                hlt();
            }
            continue;
        }

        cpu_acct_work_end();
        # Pace to target_fps / vsync_hz and HLT the slack until the deadline.
        # This is both the frame-pacing fix (even frame time, configurable cap)
        # and the idle-power fix (sleep on the timer IRQ instead of spinning).
        if feat_on(FEAT_FRAME_PACING) != 0 {
            frame_pace_wait();
        }
    }
}
