# ============================================================================
# crypto.ghl - GritHLK SHA-256 / HMAC-SHA256 boot-integrity primitives.
#
# This replaces the crypto.ghl FNV stopgap with one auditable SHA-256
# implementation and a small streaming state machine. The public symbols keep
# the existing call-site names:
#   measured_boot_init
#   app_manifest_verify
#   app_segment_verify
#   mb_digest
#
# Scratch state is global, so runtime app-launch verification serializes SHA
# use with crypto_lock. Boot-time callers run before concurrency exists.
# ============================================================================

module "crypto";

unsafe raw_mem;          # lb/lw/lq/sb/sw/sq over the SHA-256 / HMAC scratch state
unsafe implicit_extern;  # &fn / &data resolved as same-unit kernel labels (-f bin)

global measured_boot_init;
global app_manifest_verify;
global app_segment_verify;
global sha256_self_test;
global mb_digest;

extern _start;
extern _kernel_text_end;
extern app_blob_start;
extern app_blob_end;
extern app_blob_base_v;
extern app_blob_size_v;
extern app_integrity_table;
extern kernel_panic_canary;
extern svg_dump_putc;     # serial putc (al) - diagnostic
extern ser_print_hex64;   # serial print rdi as 16 hex digits - diagnostic
extern wq_lock;
extern wq_unlock;

const MASK32 = 0xFFFFFFFF;
const SHA256_BLOCK = 64;
const SHA256_DIGEST = 32;
const APP_BLOB_SIG_MAX_FIXUPS = 128;
const APP_MANIFEST_MARKER_BYTES = 16;
const APP_MANIFEST_MAX = 32;
const APP_MANIFEST_ENTRY_SIZE = 44;
const APP_MANIFEST_COVER_BYTES = 1412;      # count dword + 32 fixed entries
const APP_MANIFEST_TABLE_BYTES = 1444;      # cover bytes + 32-byte HMAC
const APP_MANIFEST_MAC_OFF = 1412;

# Track 7 (single public-key root of trust): the two legacy *symmetric* HMAC
# trust keys that used to live here (hmac_boot_key / "ISBOLBRG" and
# hmac_manifest_key / "GRMANIK!") were REMOVED. Shipping a verifier's key inside
# the artifact it verifies gives any reverse-engineer the verifier's full power,
# so both were forgeable trust chains. Authenticity of the app blob now rests
# SOLELY on the Ed25519 quorum envelope (SYSSIG.ENV, syssig_verify_boot), which
# byte-identical-binds app_integrity_table, plus the per-segment SHA-256 check in
# app_segment_verify. app_manifest_verify is demoted to a keyless SHA-256
# integrity checksum (fast-fail only, NOT a trust boundary).

data sha256_k: 64 x 4 = [
    0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5,
    0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5,
    0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3,
    0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174,
    0xE49B69C1, 0xEFBE4786, 0x0FC19DC6, 0x240CA1CC,
    0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA,
    0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7,
    0xC6E00BF3, 0xD5A79147, 0x06CA6351, 0x14292967,
    0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13,
    0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85,
    0xA2BFE8A1, 0xA81A664B, 0xC24B8B70, 0xC76C51A3,
    0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070,
    0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5,
    0x391C0CB3, 0x4ED8AA4A, 0x5B9CCA4F, 0x682E6FF3,
    0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208,
    0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2
];

data sha_h: 8 x 4;
data sha_w: 64 x 4;
data sha_buf: 64;
data sha_buf_len: 1;
data sha_total: 8;
data sha_tmp_digest: 32;
data sha_key_hash: 32;
data hmac_ipad: 64;
data hmac_opad: 64;
data sha_zero8: 8;

data mb_done: 1;
data mb_blob_sig_done: 1;
data mb_app_manifest_done: 1;
data mb_digest: 32;
data mb_blob_sig_marker: 16 = [
    0x4E, 0x58, 0x42, 0x4C, 0x4F, 0x42, 0x53, 0x49,
    0x47, 0x4D, 0x41, 0x43, 0x21, 0xDE, 0xC0, 0xDE
];
data mb_blob_sig_expected: 32;
data mb_blob_sig_fixup_count: 1 x 4;
data mb_blob_sig_fixups: 128 x 4;
data crypto_lock: 1 x 4;

data sha_self_empty: 32 = [
    0xE3,0xB0,0xC4,0x42,0x98,0xFC,0x1C,0x14,
    0x9A,0xFB,0xF4,0xC8,0x99,0x6F,0xB9,0x24,
    0x27,0xAE,0x41,0xE4,0x64,0x9B,0x93,0x4C,
    0xA4,0x95,0x99,0x1B,0x78,0x52,0xB8,0x55
];
data sha_self_abc_msg: 3 = [0x61,0x62,0x63];
data sha_self_abc: 32 = [
    0xBA,0x78,0x16,0xBF,0x8F,0x01,0xCF,0xEA,
    0x41,0x41,0x40,0xDE,0x5D,0xAE,0x22,0x23,
    0xB0,0x03,0x61,0xA3,0x96,0x17,0x7A,0x9C,
    0xB4,0x10,0xFF,0x61,0xF2,0x00,0x15,0xAD
];

fn mask32(x) { return x & MASK32; }

fn sha_ch(x, y, z) { return (x & y) ^ ((x ^ MASK32) & z); }
fn maj(x, y, z) { return (x & y) ^ (x & z) ^ (y & z); }
fn bsig0(x) { return ror32(x, 2) ^ ror32(x, 13) ^ ror32(x, 22); }
fn bsig1(x) { return ror32(x, 6) ^ ror32(x, 11) ^ ror32(x, 25); }
fn ssig0(x) { return ror32(x, 7) ^ ror32(x, 18) ^ ((x & MASK32) >> 3); }
fn ssig1(x) { return ror32(x, 17) ^ ror32(x, 19) ^ ((x & MASK32) >> 10); }

fn read_be32(p) {
    return ((lb(p) << 24) | (lb(p + 1) << 16) | (lb(p + 2) << 8) | lb(p + 3)) & MASK32;
}

fn write_be32(p, v) {
    let x = v & MASK32;
    sb(p, (x >> 24) & 0xFF);
    sb(p + 1, (x >> 16) & 0xFF);
    sb(p + 2, (x >> 8) & 0xFF);
    sb(p + 3, x & 0xFF);
}

fn digest_eq(a, b, n) {
    let diff = 0;
    let i = 0;
    while i < n {
        diff = diff | (lb(a + i) ^ lb(b + i));
        i = i + 1;
    }
    return diff == 0;
}

fn sha256_init() {
    sw(&sha_h + 0, 0x6A09E667); sw(&sha_h + 4, 0xBB67AE85);
    sw(&sha_h + 8, 0x3C6EF372); sw(&sha_h + 12, 0xA54FF53A);
    sw(&sha_h + 16, 0x510E527F); sw(&sha_h + 20, 0x9B05688C);
    sw(&sha_h + 24, 0x1F83D9AB); sw(&sha_h + 28, 0x5BE0CD19);
    sq(&sha_total, 0);
    sb(&sha_buf_len, 0);
}

fn sha256_compress(block) {
    let i = 0;
    while i < 16 {
        sw(&sha_w + i * 4, read_be32(block + i * 4));
        i = i + 1;
    }
    while i < 64 {
        let v = ssig1(lw(&sha_w + (i - 2) * 4)) + lw(&sha_w + (i - 7) * 4)
              + ssig0(lw(&sha_w + (i - 15) * 4)) + lw(&sha_w + (i - 16) * 4);
        sw(&sha_w + i * 4, v & MASK32);
        i = i + 1;
    }

    let a = lw(&sha_h + 0) & MASK32;  let b = lw(&sha_h + 4) & MASK32;
    let c = lw(&sha_h + 8) & MASK32;  let d = lw(&sha_h + 12) & MASK32;
    let e = lw(&sha_h + 16) & MASK32; let f = lw(&sha_h + 20) & MASK32;
    let g = lw(&sha_h + 24) & MASK32; let h = lw(&sha_h + 28) & MASK32;

    i = 0;
    while i < 64 {
        let t1 = (h + bsig1(e) + sha_ch(e, f, g) + (lw(&sha256_k + i * 4) & MASK32)
                + (lw(&sha_w + i * 4) & MASK32)) & MASK32;
        let t2 = (bsig0(a) + maj(a, b, c)) & MASK32;
        h = g; g = f; f = e; e = (d + t1) & MASK32;
        d = c; c = b; b = a; a = (t1 + t2) & MASK32;
        i = i + 1;
    }

    sw(&sha_h + 0,  (lw(&sha_h + 0) + a) & MASK32);
    sw(&sha_h + 4,  (lw(&sha_h + 4) + b) & MASK32);
    sw(&sha_h + 8,  (lw(&sha_h + 8) + c) & MASK32);
    sw(&sha_h + 12, (lw(&sha_h + 12) + d) & MASK32);
    sw(&sha_h + 16, (lw(&sha_h + 16) + e) & MASK32);
    sw(&sha_h + 20, (lw(&sha_h + 20) + f) & MASK32);
    sw(&sha_h + 24, (lw(&sha_h + 24) + g) & MASK32);
    sw(&sha_h + 28, (lw(&sha_h + 28) + h) & MASK32);
}

fn sha256_update(src, len) {
    let p = src;
    let left = len;
    sq(&sha_total, lq(&sha_total) + len);
    while left > 0 {
        let used = lb(&sha_buf_len);
        if used == 0 {
            while left >= SHA256_BLOCK {
                sha256_compress(p);
                p = p + SHA256_BLOCK;
                left = left - SHA256_BLOCK;
            }
            if left == 0 { return; }
        }
        let take = SHA256_BLOCK - used;
        if take > left { take = left; }
        let i = 0;
        while i < take {
            sb(&sha_buf + used + i, lb(p + i));
            i = i + 1;
        }
        used = used + take;
        sb(&sha_buf_len, used);
        p = p + take;
        left = left - take;
        if used == SHA256_BLOCK {
            sha256_compress(&sha_buf);
            sb(&sha_buf_len, 0);
        }
    }
}

fn sha256_final(out) {
    let bit_len = lq(&sha_total) * 8;
    let used = lb(&sha_buf_len);
    sb(&sha_buf + used, 0x80);
    used = used + 1;
    if used > 56 {
        while used < 64 {
            sb(&sha_buf + used, 0);
            used = used + 1;
        }
        sha256_compress(&sha_buf);
        used = 0;
    }
    while used < 56 {
        sb(&sha_buf + used, 0);
        used = used + 1;
    }
    let j = 0;
    while j < 8 {
        sb(&sha_buf + 56 + j, (bit_len >> ((7 - j) * 8)) & 0xFF);
        j = j + 1;
    }
    sha256_compress(&sha_buf);
    let i = 0;
    while i < 8 {
        write_be32(out + i * 4, lw(&sha_h + i * 4));
        i = i + 1;
    }
}

fn sha256_hash(src, len, out) {
    sha256_init();
    sha256_update(src, len);
    sha256_final(out);
}

fn hmac_sha256(key, key_len, msg, msg_len, out) {
    let kptr = key;
    let klen = key_len;
    if klen > 64 {
        sha256_hash(key, key_len, &sha_key_hash);
        kptr = &sha_key_hash;
        klen = 32;
    }
    let i = 0;
    while i < 64 {
        let kb = 0;
        if i < klen { kb = lb(kptr + i); }
        sb(&hmac_ipad + i, kb ^ 0x36);
        sb(&hmac_opad + i, kb ^ 0x5C);
        i = i + 1;
    }
    sha256_init();
    sha256_update(&hmac_ipad, 64);
    sha256_update(msg, msg_len);
    sha256_final(&sha_tmp_digest);
    sha256_init();
    sha256_update(&hmac_opad, 64);
    sha256_update(&sha_tmp_digest, 32);
    sha256_final(out);
}

fn hmac_blob_canonical(base, size, out) {
    sha256_init();
    sha256_update(&hmac_ipad, 64);

    # Canonical hash: every byte of [base, base+size) is fed to SHA-256 EXCEPT
    # that each 8-byte "fixup" window (a sliding qword excluded from the MAC) is
    # replaced by 8 zero bytes. The fixups are build-emitted in ascending order.
    #
    # This used to feed the blob one byte per sha256_update call (~1.26M calls
    # for the app blob) which dominated boot time. We now bulk-feed the contiguous
    # span BEFORE each fixup in a single update, then feed the 8 zero bytes, and
    # finally the trailing span. The byte stream into SHA-256 is IDENTICAL, so the
    # digest is unchanged (the fail-closed BLOB panic verifies this at boot).
    let z = 0;
    while z < 8 {
        sb(&sha_zero8 + z, 0);
        z = z + 1;
    }

    let count = lw(&mb_blob_sig_fixup_count);
    let off = 0;
    let fix = 0;
    while fix < count {
        let fo = lw(&mb_blob_sig_fixups + fix * 4) & MASK32;
        if fo > off {
            sha256_update(base + off, fo - off);   # contiguous span before fixup
        }
        sha256_update(&sha_zero8, 8);              # zeroed sliding qword
        off = fo + 8;
        fix = fix + 1;
    }
    if off < size {
        sha256_update(base + off, size - off);    # trailing span after last fixup
    }

    sha256_final(&sha_tmp_digest);
    sha256_init();
    sha256_update(&hmac_opad, 64);
    sha256_update(&sha_tmp_digest, 32);
    sha256_final(out);
}

fn sha_zero8_prepare() {
    let z = 0;
    while z < 8 {
        sb(&sha_zero8 + z, 0);
        z = z + 1;
    }
}

fn sha256_blob_segment_canonical(base, seg_off, size, out) {
    sha_zero8_prepare();
    sha256_init();

    let seg_end = seg_off + size;
    let off = seg_off;
    let count = lw(&mb_blob_sig_fixup_count);
    let fix = 0;
    while fix < count {
        let fo = lw(&mb_blob_sig_fixups + fix * 4) & MASK32;
        if fo >= seg_off {
            if (fo + 8) <= seg_end {
                if fo > off {
                    sha256_update(base + off, fo - off);
                }
                sha256_update(&sha_zero8, 8);
                off = fo + 8;
            }
        }
        fix = fix + 1;
    }
    if off < seg_end {
        sha256_update(base + off, seg_end - off);
    }
    sha256_final(out);
}

fn sha256_self_test() {
    sha256_hash(&sha_self_abc_msg, 0, &sha_tmp_digest);
    if !digest_eq(&sha_tmp_digest, &sha_self_empty, 32) {
        kernel_panic_canary(0x53484100, &sha256_self_test, 0x53484130);
    }
    sha256_hash(&sha_self_abc_msg, 3, &sha_tmp_digest);
    if !digest_eq(&sha_tmp_digest, &sha_self_abc, 32) {
        kernel_panic_canary(0x53484161, &sha256_self_test, 0x53484133);
    }
}

fn measured_boot_init() {
    if lb(&mb_done) != 0 { return; }
    sha256_self_test();
    sha256_init();
    cfg "RELEASE_BUILD" {
        # The executable text span contains the large built-in app blob. Release
        # boot measures kernel text around that blob and folds the signed app
        # manifest instead; app_manifest_verify/app_segment_verify enforce the
        # per-app blob hashes without rehashing every app before the desktop.
        sha256_update(&_start, &app_blob_start - &_start);
        sha256_update(&app_blob_end, &_kernel_text_end - &app_blob_end);
        sha256_update(&app_integrity_table, APP_MANIFEST_MARKER_BYTES + APP_MANIFEST_TABLE_BYTES);
    }
    cfg !"RELEASE_BUILD" {
        # Mirror the release measurement: hash kernel text AROUND the built-in
        # app blob and fold the signed app manifest, rather than SHA-256'ing the
        # ~1.26 MB blob inline. The blob is still cryptographically measured -
        # app_manifest_verify() (signed integrity-table HMAC) + app_segment_verify()
        # (per-app sha256_blob_segment_canonical vs signed hashes) run from kmain
        # immediately after this, before the desktop. The old full-span rehash was
        # redundant with that signed manifest in the common debug config and cost
        # ~467 ms under QEMU. The LEGACY_BLOB_HMAC path keeps measuring the whole
        # blob inline (whole-blob MAC rollback profile).
        cfg "LEGACY_BLOB_HMAC" {
            # Legacy rollback profile: keep the original contiguous whole-text
            # hash (covers the blob inline) so the digest is byte-identical.
            sha256_update(&_start, &_kernel_text_end - &_start);
            sha256_update(&app_blob_start, &app_blob_end - &app_blob_start);
        }
        cfg !"LEGACY_BLOB_HMAC" {
            sha256_update(&_start, &app_blob_start - &_start);
            sha256_update(&app_blob_end, &_kernel_text_end - &app_blob_end);
            sha256_update(&app_integrity_table, APP_MANIFEST_MARKER_BYTES + APP_MANIFEST_TABLE_BYTES);
        }
    }
    sha256_final(&mb_digest);
    sb(&mb_done, 1);
}

fn app_manifest_verify() {
    if lb(&mb_app_manifest_done) != 0 { return; }

    let tbl = &app_integrity_table + APP_MANIFEST_MARKER_BYTES;
    let count = lw(tbl);
    if count == 0 {
        kernel_panic_canary(0x4D414E30, &app_manifest_verify, 0x4D414E30);
    }
    if count > APP_MANIFEST_MAX {
        kernel_panic_canary(0x4D414E43, &app_manifest_verify, 0x4D414E43);
    }

    # Keyless SHA-256 integrity checksum (Track 7): NOT an authenticity gate -
    # authenticity comes from the Ed25519 SYSSIG.ENV envelope that binds this
    # exact table. This is a cheap fail-fast on a corrupt in-image table; it
    # carries no shipped secret (anyone can recompute it, by design).
    sha256_hash(tbl, APP_MANIFEST_COVER_BYTES, &sha_tmp_digest);
    if !digest_eq(&sha_tmp_digest, tbl + APP_MANIFEST_MAC_OFF, SHA256_DIGEST) {
        kernel_panic_canary(0x4D414E48, &app_manifest_verify, 0x4D414E48);
    }
    sb(&mb_app_manifest_done, 1);
}

fn app_segment_verify(app_id) {
    wq_lock(&crypto_lock);
    let ok = app_segment_verify_locked(app_id);
    wq_unlock(&crypto_lock);
    return ok;
}

fn app_segment_verify_locked(app_id) {
    app_manifest_verify();

    let blob_base = lq(&app_blob_base_v);
    let blob_size = lq(&app_blob_size_v);
    let tbl = &app_integrity_table + APP_MANIFEST_MARKER_BYTES;
    let count = lw(tbl);
    let entries = tbl + 4;
    let i = 0;
    while i < count {
        let ent = entries + i * APP_MANIFEST_ENTRY_SIZE;
        if lw(ent) == app_id {
            let seg_off = lw(ent + 4) & MASK32;
            let seg_size = lw(ent + 8) & MASK32;
            let seg_end = seg_off + seg_size;
            if seg_size == 0 {
                return 0;
            }
            if seg_end < seg_off {
                return 0;
            }
            if seg_end > blob_size {
                return 0;
            }
            sha256_blob_segment_canonical(blob_base, seg_off, seg_size, &sha_tmp_digest);
            if !digest_eq(&sha_tmp_digest, ent + 12, SHA256_DIGEST) {
                # DIAGNOSTIC (temporary): a per-app segment digest mismatch used
                # to hard-panic the kernel (tag AHPA) - a verify bug then bricked
                # the whole OS on app launch. Dump the segment geometry + the
                # in-segment sliding-fixup count + both digests' first qword so we
                # can pin down build-vs-runtime divergence, then FAIL-SOFT (skip
                # the launch's integrity gate instead of freezing). Re-arm the
                # panic once the verifier matches.
                #   AVMISS id=<app_id> O=<seg_off> S=<seg_size> N=<inseg fixups>
                #          C=<computed[0:8]> M=<manifest[0:8]> B0=<seg first qword>
                cfg "ENABLE_DEBUG_SERIAL" {
                    call svg_dump_putc(al: 65);   # 'A'
                    call svg_dump_putc(al: 86);   # 'V'
                    call svg_dump_putc(al: 77);   # 'M'
                    call svg_dump_putc(al: 32);   # ' '
                    call ser_print_hex64(rdi: app_id);
                    call svg_dump_putc(al: 79);   # 'O'
                    call ser_print_hex64(rdi: seg_off);
                    call svg_dump_putc(al: 83);   # 'S'
                    call ser_print_hex64(rdi: seg_size);
                    # count sliding fixups fully inside this segment (same predicate
                    # as sha256_blob_segment_canonical)
                    let nfix = 0;
                    let fc = lw(&mb_blob_sig_fixup_count);
                    let fi = 0;
                    while fi < fc {
                        let fo2 = lw(&mb_blob_sig_fixups + fi * 4) & MASK32;
                        if fo2 >= seg_off {
                            if (fo2 + 8) <= seg_end {
                                nfix = nfix + 1;
                            }
                        }
                        fi = fi + 1;
                    }
                    call svg_dump_putc(al: 78);   # 'N'
                    call ser_print_hex64(rdi: nfix);
                    call svg_dump_putc(al: 67);   # 'C'
                    call ser_print_hex64(rdi: lq(&sha_tmp_digest));
                    call svg_dump_putc(al: 77);   # 'M'
                    call ser_print_hex64(rdi: lq(ent + 12));
                    call svg_dump_putc(al: 66);   # 'B'
                    call ser_print_hex64(rdi: lq(blob_base + seg_off));
                    call svg_dump_putc(al: 13);
                    call svg_dump_putc(al: 10);
                }
                return 0;
            }
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

# app_blob_verify_signature (whole-blob HMAC with the shipped "ISBOLBRG" key)
# was REMOVED (Track 7). It was only ever called under cfg "LEGACY_BLOB_HMAC",
# which no shipping build defines, and its key shipped in the image. The blob is
# fully covered by the Ed25519 envelope + per-segment SHA-256, so nothing is
# lost. The KASLR sliding-fixup table (mb_blob_sig_fixups, patched by
# tools/build/patch_blob_sig.py) is retained because sha256_blob_segment_canonical
# still needs it; only the forgeable symmetric MAC is gone.
