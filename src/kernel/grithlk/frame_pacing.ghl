# ============================================================================
# frame_pacing.ghl - GritHLK (ZERO-ASM) main-loop frame pacer + idle HLT.
#
# Problem this fixes (real-HW + VM report):
#   * The free-running main loop rendered a frame on EVERY wakeup (every PIT
#     tick AND every mouse/USB/net IRQ), with no frame-time budget. Result:
#     inconsistent low FPS that *feels* like 10-20 fps, and - because there was
#     no deadline to sleep toward - the CPU never settled into a deep idle, so
#     the machine ran hot and drained the battery on a barebones OS.
#   * vsync mode busy-spun (display.asm wait_vsync's 0x3DA probe + 5M-iter PIT
#     spin), burning the core instead of sleeping.
#
# Strategy: a single deadline-driven pacer the main loop calls once per frame.
#   - Compute the per-frame TSC budget from a target rate:
#       vsync off -> target_fps (default 180)
#       vsync on  -> vsync_hz   (default 180; user panel = 180)
#     Both clamped to 5..1000 Hz.
#   - Hold a running `next_deadline` TSC stamp. Each frame we wait until rdtsc()
#     reaches it, then advance it by exactly one budget - this gives EVEN frame
#     pacing (constant frame time), not the old IRQ-rate jitter.
#   - While waiting: if interrupts are enabled AND more than one PIT period of
#     slack remains, HLT (sleep until the next IRQ). A 180 Hz frame budget is
#     shorter than the 100 Hz PIT period, so sub-tick waits must still sleep;
#     otherwise idle turns into a continuous PAUSE spin.
#   - If we have already overrun the deadline (a heavy frame), we DON'T sleep
#     and we re-base the deadline to now, so a slow frame can't make the next
#     frame "catch up" with a burst (which would look like a stutter).
#
# Timebase: cpu_tsc_per_tick = calibrated TSC cycles per PIT tick (10 ms). So
#   cycles/second = cpu_tsc_per_tick * 100, and cycles/frame = that / rate.
# All UEFI-GOP / generic-HW safe: no GPU, no 0x3DA dependence.
# ============================================================================

module "frame_pacing";

unsafe kernel_priv;       # rdtsc / hlt / pause / sti / read_flags
unsafe raw_mem;           # lb/lw/lq/sq of pacer state + tunables
unsafe implicit_extern;   # &tick_count / &cpu_tsc_per_tick / &target_fps / ...

global frame_pace_reset;
global frame_pace_activity;
global frame_pace_wait;

extern scene_dirty;       # byte: a repaint is pending (keyboard/app activity)

extern tick_count;        # qword, advanced by the PIT handler (100 Hz)
extern cpu_tsc_per_tick;  # qword, calibrated TSC cycles per 10 ms PIT tick
extern vsync_enabled;     # byte:  0 = fps-cap pacing, !=0 = vsync_hz pacing
extern target_fps;        # dword: fps cap when vsync off (default 180)
extern vsync_hz;          # dword: target refresh when vsync on (default 180)

const RATE_MIN = 5;       # Hz floor (matches the 5..1000 range the UI exposes)
const RATE_MAX = 1000;    # Hz ceiling

# Pacer state (module-local).
data fp_next_deadline: 1 x 8 = 0;   # TSC stamp the current frame waits for
data fp_have_deadline: 1 x 1 = 0;   # 0 until first frame seeds the deadline

data fp_activity_tsc: 1 x 8 = 0;    # TSC of the last observed GUI activity

# Idle frame governor: after IDLE_DOWNSHIFT_TICKS with no activity, pace the
# loop at IDLE_FPS instead of the full panel target. GUI/input code calls
# frame_pace_activity() on pointer, keyboard, app, or repaint activity; the
# pacer itself never polls devices or routes input.
const IDLE_DOWNSHIFT_TICKS = 200;   # 2 s of nothing before downshifting
const IDLE_FPS = 60;                # quiet desktop refresh floor

# Effective target rate in Hz, clamped to RATE_MIN..RATE_MAX. vsync_enabled
# selects vsync_hz; otherwise target_fps. A 0/garbage value falls back to 60.
fn fp_target_rate() {
    let rate = lw(&target_fps);
    if lb(&vsync_enabled) != 0 { rate = lw(&vsync_hz); }
    if rate <= 0 { rate = 60; }
    if rate < RATE_MIN { rate = RATE_MIN; }
    if rate > RATE_MAX { rate = RATE_MAX; }
    return rate;
}

# TSC cycles allotted to one frame at the current target rate. cpu_tsc_per_tick
# is per 10 ms tick, so cycles/s = cpu_tsc_per_tick * 100; per frame = / rate.
# If calibration hasn't produced a value yet, fall back to one PIT tick so the
# pacer still bounds the rate to ~100 fps instead of free-running.
fn fp_frame_budget() {
    let tpt = lq(&cpu_tsc_per_tick);
    if tpt == 0 { return 1; }
    let budget = (tpt * 100) / fp_effective_rate();
    if budget == 0 { budget = 1; }
    return budget;
}

# Idle predicate: no real interactive activity for IDLE_DOWNSHIFT_TICKS. Only
# frame_pace_activity() (pointer move, click, keyboard, app/input events - see
# ml_mark_active) stamps fp_activity_tsc. A bare repaint (scene_dirty) does NOT
# count: a live Task Manager dirties the scene ~1x/s, and if that re-armed the
# activity stamp the loop would never downshift and would precision-spin a quiet
# desktop at the full 180 Hz target (high CPU0 at idle). The repaint still gets
# rendered - it just doesn't keep the pacer in the hot spin path.
fn fp_is_idle() {
    let tick_tsc = lq(&cpu_tsc_per_tick);
    if tick_tsc == 0 { return 0; }
    if (rdtsc() - lq(&fp_activity_tsc)) > (tick_tsc * IDLE_DOWNSHIFT_TICKS) { return 1; }
    return 0;
}

# Target rate with the idle governor applied. Interactive activity is stamped by
# frame_pace_activity(); see fp_is_idle for why a bare repaint does not.
fn fp_effective_rate() {
    let rate = fp_target_rate();
    if fp_is_idle() != 0 {
        if rate > IDLE_FPS { rate = IDLE_FPS; }
    }
    return rate;
}

# Force the next frame to re-seed its deadline from now (used when entering the
# loop, or after a long stall, so we don't try to "catch up" a huge backlog).
fn frame_pace_reset() {
    sb(&fp_have_deadline, 0);
    # Seed the activity stamp so boot starts at full rate (a zero stamp would
    # read as "idle for ages" and downshift the very first frames).
    sq(&fp_activity_tsc, rdtsc());
}

fn frame_pace_activity() {
    sq(&fp_activity_tsc, rdtsc());
}

# Pace the GUI loop. Two regimes, because a 100 Hz PIT cannot HLT-sleep finer
# than one 10 ms tick, yet the panel target is 180 Hz:
#
#   IDLE  (no interactive activity for IDLE_DOWNSHIFT_TICKS): sleep until the
#         next interrupt - a single HLT. A quiet desktop, even with a live Task
#         Manager repainting ~1x/s, costs ~0% CPU; an input/PIT IRQ wakes us
#         within one PIT period so the first pointer move re-arms full rate.
#
#   ACTIVE (recent pointer/keyboard/app activity): precision-pace to target_fps.
#         HLT the bulk of the wait one PIT tick at a time, then PAUSE-spin only
#         the final sub-tick stretch. This is the ONLY way to reach 180 Hz on a
#         100 Hz timer (the 5.5 ms frame is shorter than a tick, so the tail is
#         a short busy-wait) - the CPU cost is paid only while the user is
#         actually interacting, and falls back to ~0% the moment they stop.
fn frame_pace_wait() {
    # Idle: don't precision-spin a quiet desktop. Re-seed the deadline so that
    # when activity resumes the first active frame bases its budget on "now".
    if fp_is_idle() != 0 {
        sb(&fp_have_deadline, 0);
        if (read_flags() & 0x200) != 0 { hlt(); } else { pause(); }
        return;
    }

    let budget = fp_frame_budget();
    let now = rdtsc();
    let tick_tsc = lq(&cpu_tsc_per_tick);

    # Seed / re-seed: first active frame, or we fell so far behind that catching
    # up would burst. Pace from now.
    if lb(&fp_have_deadline) == 0 {
        sq(&fp_next_deadline, now + budget);
        sb(&fp_have_deadline, 1);
    }

    let deadline = lq(&fp_next_deadline);

    # Already past the deadline (heavy frame / PIT overshoot): re-base to now so
    # the next frame gets a full fresh budget rather than a compensating burst.
    if now >= deadline {
        deadline = now + budget;
        sq(&fp_next_deadline, deadline);
    }

    while now < deadline {
        let remaining = deadline - now;
        # HLT the bulk while at least one PIT period of slack remains, so a timer
        # IRQ is guaranteed to wake us before we overshoot (but only with IF set;
        # with IF clear, hlt would hang forever - fall through to the spin).
        if tick_tsc != 0 {
            if remaining > tick_tsc {
                if (read_flags() & 0x200) != 0 {
                    hlt();
                    now = rdtsc();
                    continue;
                }
            }
        }
        # Final sub-tick stretch (or IF masked): short busy-wait for accuracy.
        pause();
        now = rdtsc();
    }

    # Advance to the next frame boundary (steady cadence, not now-relative).
    sq(&fp_next_deadline, deadline + budget);
}
